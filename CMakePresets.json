{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "Ninja, a build tree named after the preset, and a compilation database for the language server, on whatever toolchain the environment provides: MSVC, AppleClang, GCC or Clang. The compiler launchers come from the environment, so exporting CMAKE_CXX_COMPILER_LAUNCHER=ccache caches objects. Only the machine profiles add instruction-set flags, so every other tree runs on any CPU of its architecture.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build_${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_OPTIMIZE_DEPENDENCIES": "ON",
        "CMAKE_C_COMPILER_LAUNCHER": "$env{CMAKE_C_COMPILER_LAUNCHER}",
        "CMAKE_CXX_COMPILER_LAUNCHER": "$env{CMAKE_CXX_COMPILER_LAUNCHER}",
        "CMAKE_CUDA_COMPILER_LAUNCHER": "$env{CMAKE_CUDA_COMPILER_LAUNCHER}"
      }
    },
    {
      "name": "linux",
      "hidden": true,
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "windows",
      "hidden": true,
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "clang",
      "hidden": true,
      "inherits": "base",
      "description": "Clang, which compiles faster and lighter than GCC, and is AppleClang on macOS.",
      "cacheVariables": { "CMAKE_C_COMPILER": "clang", "CMAKE_CXX_COMPILER": "clang++" }
    },
    {
      "name": "llvm",
      "hidden": true,
      "inherits": "clang",
      "description": "Clang and lld, which the sanitizer, tracing and line-table flags of the development presets assume. `lld` links several times faster than `bfd` and `ld64`.",
      "cacheVariables": {
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=lld",
        "CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=lld"
      }
    },
    {
      "name": "debug",
      "inherits": "llvm",
      "displayName": "Debug - suites under AddressSanitizer",
      "description": "Unoptimized suites and the CLI on every engine, with AddressSanitizer and UndefinedBehaviorSanitizer over UStore's own targets; the storage engines and siblings keep their own flags.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "USTORE_BUILD_SANITIZERS": "address",
        "USTORE_BUILD_TEST": "ON",
        "USTORE_BUILD_TOOLS": "ON",
        "USTORE_BUILD_SHARED": "ON"
      }
    },
    {
      "name": "check",
      "inherits": "llvm",
      "displayName": "Check - fastest compile cycle",
      "description": "Does it still compile, nothing more: -O0 without debug information over every UStore target, with warnings as errors.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O0 -g0 -DNDEBUG",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O0 -g0 -DNDEBUG",
        "CMAKE_CUDA_FLAGS_RELWITHDEBINFO": "-O0 -Xcicc -O0 -Xptxas -O0 -DNDEBUG",
        "USTORE_BUILD_TEST": "ON",
        "USTORE_BUILD_BENCH": "ON",
        "USTORE_BUILD_TOOLS": "ON",
        "USTORE_BUILD_SHARED": "ON",
        "USTORE_WERROR": "ON"
      }
    },
    {
      "name": "relwithdebinfo",
      "inherits": "llvm",
      "displayName": "RelWithDebInfo - optimized suites with symbols",
      "description": "Optimized, with full DWARF for stepping through the suites.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "USTORE_BUILD_TEST": "ON",
        "USTORE_BUILD_TOOLS": "ON",
        "USTORE_BUILD_SHARED": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "clang",
      "displayName": "Release - every CPU target",
      "description": "Libraries, suites, benchmarks and the CLI on every engine, RocksDB and LevelDB included.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_FLAGS": "-ffile-prefix-map=${sourceDir}=.",
        "CMAKE_CXX_FLAGS": "-ffile-prefix-map=${sourceDir}=.",
        "USTORE_WITH_ROCKSDB": "ON",
        "USTORE_WITH_LEVELDB": "ON",
        "USTORE_BUILD_TEST": "ON",
        "USTORE_BUILD_BENCH": "ON",
        "USTORE_BUILD_TOOLS": "ON",
        "USTORE_BUILD_SHARED": "ON"
      }
    },
    {
      "name": "profile",
      "inherits": "llvm",
      "displayName": "Profile - benchmarks under perf",
      "description": "The profiling tree behind bench/README.md: full optimization, plus the symbols `perf` needs to attribute samples.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O3 -g -DNDEBUG",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O3 -g -DNDEBUG",
        "USTORE_BUILD_BENCH": "ON",
        "USTORE_BUILD_SHARED": "ON"
      }
    },
    {
      "name": "tsan",
      "inherits": "llvm",
      "displayName": "TSan - concurrency suites under ThreadSanitizer",
      "description": "ThreadSanitizer over UStore's own targets in RelWithDebInfo, in a tree of its own because Debug arms AddressSanitizer, which cannot share a process with it. The storage engines and siblings keep their release flags, and UStore's targets drop to -O1.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "USTORE_BUILD_SANITIZERS": "thread",
        "USTORE_BUILD_TEST": "ON"
      }
    },
    {
      "name": "dev",
      "inherits": "llvm",
      "displayName": "Dev - everything",
      "description": "The iteration tree that `.clangd` reads: every CPU target, optimized enough to run, with line tables instead of full DWARF.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O2 -gline-tables-only -DNDEBUG",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O2 -gline-tables-only -DNDEBUG",
        "USTORE_BUILD_TEST": "ON",
        "USTORE_BUILD_BENCH": "ON",
        "USTORE_BUILD_TOOLS": "ON",
        "USTORE_BUILD_SHARED": "ON"
      }
    },
    {
      "name": "cuda",
      "inherits": "dev",
      "displayName": "CUDA - the NVMe engine with GPU compaction",
      "description": "The dev tree plus the NVMe engine and its CUDA compaction, compiled for the GPUs of this machine alone.",
      "cacheVariables": {
        "CMAKE_CUDA_FLAGS_RELWITHDEBINFO": "-O2 -lineinfo -DNDEBUG",
        "USTORE_WITH_NVME": "ON",
        "CMAKE_CUDA_HOST_COMPILER": "clang++",
        "USTORE_CUDA_ARCH": "native"
      }
    },
    {
      "name": "linux_cuda_rocm",
      "inherits": ["base", "linux"],
      "displayName": "Linux CUDA and ROCm - one library over both GPU vendors",
      "description": "ROCm's Clang compiles every host unit and NVCC hosts on Clang for the CUDA compaction, into one library that links neither vendor's runtime and drives the NVIDIA and AMD devices it opens at first use. One code per vendor, at -O0, to check that it compiles, links and loads.",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/opt/rocm/lib/llvm/bin/clang",
        "CMAKE_CXX_COMPILER": "/opt/rocm/lib/llvm/bin/clang++",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O0 -g0 -DNDEBUG",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O0 -g0 -DNDEBUG",
        "CMAKE_CUDA_FLAGS_RELWITHDEBINFO": "-O0 -Xcicc -O0 -Xptxas -O0 -DNDEBUG",
        "USTORE_BUILD_TEST": "ON",
        "USTORE_BUILD_SHARED": "ON",
        "USTORE_WITH_NVME": "ON",
        "USTORE_CUDA_ARCH": "80",
        "USTORE_ROCM_ARCH": "gfx942"
      }
    },
    {
      "name": "trace",
      "inherits": "dev",
      "displayName": "Trace - where the build time goes",
      "description": "Emits a .json next to every object; open them in a flame-graph viewer or aggregate with ClangBuildAnalyzer to see which instantiations dominate.",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O2 -gline-tables-only -DNDEBUG -ftime-trace"
      }
    },
    {
      "name": "msvc2026_x64",
      "inherits": ["release", "windows"],
      "displayName": "Windows x64 - Visual Studio 2026",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_C_FLAGS": "/DWIN32 /D_WINDOWS /pathmap:${sourceDir}=.",
        "CMAKE_CXX_FLAGS": "/DWIN32 /D_WINDOWS /EHsc /pathmap:${sourceDir}=."
      }
    },
    {
      "name": "msvc2022_arm64",
      "inherits": ["release", "windows"],
      "displayName": "Windows ARM64 - Visual Studio 2022",
      "generator": "Visual Studio 17 2022",
      "architecture": "ARM64",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_C_FLAGS": "/DWIN32 /D_WINDOWS /pathmap:${sourceDir}=.",
        "CMAKE_CXX_FLAGS": "/DWIN32 /D_WINDOWS /EHsc /pathmap:${sourceDir}=."
      }
    },
    {
      "name": "android_arm64",
      "inherits": "base",
      "displayName": "Android ARM64 - compile only",
      "description": "The libraries over the RAM engine, through the NDK's own toolchain from ANDROID_NDK_ROOT.",
      "toolchainFile": "$env{ANDROID_NDK_ROOT}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-28",
        "USTORE_BUILD_SHARED": "ON"
      }
    },
    {
      "name": "wasm32_emscripten",
      "inherits": "base",
      "displayName": "WebAssembly 32-bit under Emscripten - compile only",
      "description": "The minimal module over the RAM engine: one thread, SIMD128. Emscripten's own toolchain reads the processor from EMSCRIPTEN_SYSTEM_PROCESSOR.",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "EMSCRIPTEN_SYSTEM_PROCESSOR": "wasm32",
        "USTORE_MARCH": "v128",
        "USTORE_BUILD_SHARED": "ON"
      }
    },
    {
      "name": "wasm64_emscripten",
      "inherits": "wasm32_emscripten",
      "displayName": "WebAssembly 64-bit under Emscripten - compile only",
      "description": "The extended module over the RAM engine: Memory64, threads and Relaxed SIMD, the flags Emscripten's toolchain reads as it loads.",
      "cacheVariables": {
        "EMSCRIPTEN_SYSTEM_PROCESSOR": "wasm64",
        "USTORE_MARCH": "v128relaxed",
        "CMAKE_C_FLAGS": "--target=wasm64 -pthread",
        "CMAKE_CXX_FLAGS": "--target=wasm64 -pthread"
      }
    },
    {
      "name": "machine",
      "hidden": true,
      "inherits": ["llvm", "linux"],
      "description": "One machine: its CPU floor, every kernel-library capability spelled as 1 or 0, and its one GPU code.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "USTORE_BUILD_SHARED": "ON",
        "USTORE_WITH_NVME": "ON",
        "CMAKE_CUDA_HOST_COMPILER": "clang++",
        "USTORE_MULTIVERSIONED": "OFF"
      }
    },
    {
      "name": "xeon4_hopper",
      "inherits": "machine",
      "displayName": "Xeon 4 with Hopper - compile only",
      "cacheVariables": {
        "USTORE_MARCH": "sapphirerapids",
        "USTORE_CUDA_ARCH": "90a",
        "STRINGZILLA_TARGET_WESTMERE": "1",
        "STRINGZILLA_TARGET_GOLDMONT": "1",
        "STRINGZILLA_TARGET_HASWELL": "1",
        "STRINGZILLA_TARGET_SKYLAKE": "1",
        "STRINGZILLA_TARGET_ICELAKE": "1",
        "FORKUNION_TARGET_X86_PAUSE": "1",
        "FORKUNION_TARGET_X86_TPAUSE": "1",
        "FORKUNION_TARGET_X86_CLDEMOTE": "1",
        "FORKUNION_TARGET_X86_CMPCCXADD": "0",
        "FORKUNION_TARGET_X86_RAOINT": "0"
      }
    },
    {
      "name": "xeon6_blackwell",
      "inherits": "machine",
      "displayName": "Xeon 6 with Blackwell - compile only",
      "cacheVariables": {
        "USTORE_MARCH": "graniterapids",
        "USTORE_CUDA_ARCH": "100f",
        "STRINGZILLA_TARGET_WESTMERE": "1",
        "STRINGZILLA_TARGET_GOLDMONT": "1",
        "STRINGZILLA_TARGET_HASWELL": "1",
        "STRINGZILLA_TARGET_SKYLAKE": "1",
        "STRINGZILLA_TARGET_ICELAKE": "1",
        "FORKUNION_TARGET_X86_PAUSE": "1",
        "FORKUNION_TARGET_X86_TPAUSE": "1",
        "FORKUNION_TARGET_X86_CLDEMOTE": "1",
        "FORKUNION_TARGET_X86_CMPCCXADD": "0",
        "FORKUNION_TARGET_X86_RAOINT": "0"
      }
    },
    {
      "name": "grace_hopper",
      "inherits": "machine",
      "displayName": "Grace with Hopper - compile only",
      "description": "Grace's 128-bit SVE gains nothing over NEON, so every SVE capability is off.",
      "cacheVariables": {
        "USTORE_MARCH": "grace",
        "USTORE_CUDA_ARCH": "90a",
        "STRINGZILLA_TARGET_NEON": "1",
        "STRINGZILLA_TARGET_NEONAES": "1",
        "STRINGZILLA_TARGET_NEONSHA": "1",
        "STRINGZILLA_TARGET_SVE": "0",
        "STRINGZILLA_TARGET_SVE2": "0",
        "STRINGZILLA_TARGET_SVE2AES": "0",
        "FORKUNION_TARGET_ARM64_YIELD": "1",
        "FORKUNION_TARGET_ARM64_WFET": "0",
        "FORKUNION_TARGET_ARM64_DC_CVAC": "1",
        "FORKUNION_TARGET_ARM64_PRFM": "1",
        "FORKUNION_TARGET_ARM64_LSE": "1",
        "FORKUNION_TARGET_ARM64_RCPC": "1"
      }
    },
    {
      "name": "vera_rubin",
      "inherits": "machine",
      "displayName": "Vera with Rubin - compile only",
      "description": "Olympus cores need Clang 22 or GCC 15 and CUDA 13.4 names no Rubin code, so it compiles 100f; WFET is on, as no compiler macro reports it, and SVE off, as on Grace.",
      "cacheVariables": {
        "USTORE_MARCH": "olympus",
        "USTORE_CUDA_ARCH": "100f",
        "STRINGZILLA_TARGET_NEON": "1",
        "STRINGZILLA_TARGET_NEONAES": "1",
        "STRINGZILLA_TARGET_NEONSHA": "1",
        "STRINGZILLA_TARGET_SVE": "0",
        "STRINGZILLA_TARGET_SVE2": "0",
        "STRINGZILLA_TARGET_SVE2AES": "0",
        "FORKUNION_TARGET_ARM64_YIELD": "1",
        "FORKUNION_TARGET_ARM64_WFET": "1",
        "FORKUNION_TARGET_ARM64_DC_CVAC": "1",
        "FORKUNION_TARGET_ARM64_PRFM": "1",
        "FORKUNION_TARGET_ARM64_LSE": "1",
        "FORKUNION_TARGET_ARM64_RCPC": "1"
      }
    },
    {
      "name": "venice_mi450",
      "inherits": "machine",
      "displayName": "EPYC Venice with MI450 - compile only",
      "description": "Clang 22 names no Zen 6 core, so it compiles at znver5 and spells the rows GCC 16's znver6 implies; gfx1250 covers MI450X and MI455X.",
      "cacheVariables": {
        "USTORE_MARCH": "znver5",
        "STRINGZILLA_TARGET_WESTMERE": "1",
        "STRINGZILLA_TARGET_GOLDMONT": "1",
        "STRINGZILLA_TARGET_HASWELL": "1",
        "STRINGZILLA_TARGET_SKYLAKE": "1",
        "STRINGZILLA_TARGET_ICELAKE": "1",
        "FORKUNION_TARGET_X86_PAUSE": "1",
        "FORKUNION_TARGET_X86_TPAUSE": "0",
        "FORKUNION_TARGET_X86_CLDEMOTE": "1",
        "FORKUNION_TARGET_X86_CMPCCXADD": "0",
        "FORKUNION_TARGET_X86_RAOINT": "0"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "jobs": 0
    },
    {
      "name": "check",
      "configurePreset": "check",
      "jobs": 0
    },
    {
      "name": "relwithdebinfo",
      "configurePreset": "relwithdebinfo",
      "jobs": 0
    },
    {
      "name": "release",
      "configurePreset": "release",
      "jobs": 0
    },
    {
      "name": "profile",
      "configurePreset": "profile",
      "jobs": 0
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "jobs": 0
    },
    {
      "name": "dev",
      "configurePreset": "dev",
      "jobs": 0
    },
    {
      "name": "cuda",
      "configurePreset": "cuda",
      "jobs": 0
    },
    {
      "name": "trace",
      "configurePreset": "trace",
      "jobs": 0
    },
    { "name": "msvc2026_x64", "configurePreset": "msvc2026_x64", "configuration": "Release" },
    { "name": "msvc2022_arm64", "configurePreset": "msvc2022_arm64", "configuration": "Release" },
    { "name": "android_arm64", "configurePreset": "android_arm64", "jobs": 0 },
    { "name": "wasm32_emscripten", "configurePreset": "wasm32_emscripten", "jobs": 0 },
    { "name": "wasm64_emscripten", "configurePreset": "wasm64_emscripten", "jobs": 0 },
    { "name": "xeon4_hopper", "configurePreset": "xeon4_hopper", "jobs": 0 },
    { "name": "xeon6_blackwell", "configurePreset": "xeon6_blackwell", "jobs": 0 },
    { "name": "grace_hopper", "configurePreset": "grace_hopper", "jobs": 0 },
    { "name": "vera_rubin", "configurePreset": "vera_rubin", "jobs": 0 }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 900
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "configurePreset": "debug",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1 halt_on_error=1",
        "UBSAN_OPTIONS": "halt_on_error=1 print_stacktrace=1"
      }
    },
    {
      "name": "relwithdebinfo",
      "inherits": "base",
      "configurePreset": "relwithdebinfo"
    },
    {
      "name": "release",
      "inherits": "base",
      "configurePreset": "release"
    },
    {
      "name": "tsan",
      "inherits": "base",
      "configurePreset": "tsan",
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1 second_deadlock_stack=1"
      }
    },
    {
      "name": "dev",
      "inherits": "base",
      "configurePreset": "dev"
    },
    {
      "name": "cuda",
      "inherits": "base",
      "configurePreset": "cuda"
    },
    { "name": "msvc2026_x64", "inherits": "base", "configurePreset": "msvc2026_x64", "configuration": "Release" },
    { "name": "msvc2022_arm64", "inherits": "base", "configurePreset": "msvc2022_arm64", "configuration": "Release" }
  ],
  "workflowPresets": [
    {
      "name": "release",
      "steps": [
        {
          "type": "configure",
          "name": "release"
        },
        {
          "type": "build",
          "name": "release"
        },
        {
          "type": "test",
          "name": "release"
        }
      ]
    },
    {
      "name": "dev",
      "steps": [
        {
          "type": "configure",
          "name": "dev"
        },
        {
          "type": "build",
          "name": "dev"
        },
        {
          "type": "test",
          "name": "dev"
        }
      ]
    }
  ]
}
