      "args": [],
      "type": "shell",
      "problemMatcher": []
    },
    {
      "label": "Count Lines of Code",
      "detail": "cloc over the tracked files",
      "command": "cloc $(git ls-files)",
      "args": [],
      "type": "shell",
      "problemMatcher": []
