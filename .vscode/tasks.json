{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Debug",
      "detail": "Every engine and suite, unoptimized, with AddressSanitizer and UndefinedBehaviorSanitizer",
      "command": "cmake --preset debug && cmake --build --preset debug",
      "args": [],
      "type": "shell",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Build Release",
      "detail": "Libraries, suites, benchmarks and the CLI on every engine",
      "command": "cmake --preset release && cmake --build --preset release",
      "args": [],
      "type": "shell",
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Test Debug",
      "detail": "CTest over the sanitized tree",
      "command": "ctest --preset debug",
      "args": [],
      "type": "shell",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Build Debug SmashTable Test",
      "detail": "Unit suite on the in-memory engine",
      "command": "cmake --preset debug && cmake --build --preset debug --target ustore_test_units_ram",
      "args": [],
      "type": "shell",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Build Debug RocksDB Test",
      "detail": "Unit suite on RocksDB",
      "command": "cmake --preset debug && cmake --build --preset debug --target ustore_test_units_rocksdb",
      "args": [],
      "type": "shell",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Build Debug LevelDB Test",
