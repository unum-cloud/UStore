{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "(GDB) Attach Python",
      "type": "cppdbg",
      "request": "attach",
      "program": "/usr/bin/python3",
      "processId": "${command:pickProcess}",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb"
    },
    {
      "name": "Python C++ Debug Current File",
      "type": "pythoncpp",
      "request": "launch",
      "pythonConfig": "default",
      "cppAttachName": "(GDB) Attach Python",
    },
    {
      "name": "C++: Test SmashTable",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build_debug/build/bin/ustore_test_abi_blobs",
      "args": [
        "--engine",
        "ram",
        "--directory",
        "${workspaceFolder}/build_debug/test_data"
      ],
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "ASAN_OPTIONS",
          "value": "detect_leaks=0:atexit=1:strict_init_order=1:strict_string_checks=1"
        }
      ],
      "showDisplayString": true,
      "stopAtEntry": false,
      "externalConsole": false,
      "preLaunchTask": "Build Debug SmashTable Test",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb"
    },
    {
      "name": "C++: Test LevelDB",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build_debug/build/bin/ustore_test_abi_blobs",
      "args": [
        "--engine",
        "leveldb",
        "--directory",
        "${workspaceFolder}/build_debug/test_data"
      ],
      "cwd": "${workspaceFolder}",
      "environment": [],
      "showDisplayString": true,
      "stopAtEntry": false,
      "externalConsole": false,
      "preLaunchTask": "Build Debug LevelDB Test",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb"
    },
