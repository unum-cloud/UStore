#!/usr/bin/env bash
#
# UStore pre-commit: enforce the house style on staged changes before they land.
#
# Each check inspects only the added lines of a staged file, so legacy code migrates on its own
# schedule while no new violation sneaks in, and each prints the specific reason when it fires.
# The checks are grouped by what they enforce; the dispatch loop below diffs every staged file
# exactly once and routes it through four tiers - every C and C++ source, every C++ source, the
# CUDA sources, and the shipped library - handing the added lines to each check through the
# `file` / `added` globals. A check that needs scope reads the staged file whole and keeps only
# the hits whose line number is in `added_lines`, the same contract reached from the other side.
# Configuring the CMake build arms these hooks; see the `core.hooksPath` block in CMakeLists.txt.
#
# Bypass knowingly (you almost never should) with: git commit --no-verify

set -u
export LC_ALL=C # Byte-wise regexes, immune to the committer's locale

rejection_count=0
project_include_prefix="ustore"
sibling_projects='numkong|stringzilla|forkunion|smashtable|usearch|ucall|uform'
cmake_published_variables=""
cmake_third_party_variables="FETCHCONTENT_QUIET YYJSON_INSTALL FMT_MODULE"

# Prints the reason and the first offending lines, and counts the rejection.
fail() { # fail <matches> <message-line>...
    local matches=$1
    shift
    local line
    for line in "$@"; do echo "pre-commit: $line"; done
    printf '%s\n' "$matches" | head -5
    rejection_count=$((rejection_count + 1))
}

# region Comments and Prose

# ASCII "->" arrows inside comments & docstrings - prose uses the Unicode arrow (→). The pattern
# targets " -> " with surrounding spaces on comment-looking lines, so real member access like
# `pointer->field` in code never trips it.
check_ascii_arrows() {
    local arrows
    arrows=$(printf '%s\n' "$added" | grep -E '((//|/\*|^\+[[:space:]]*\*).* -> )' || true)
    [ -z "$arrows" ] || fail "$arrows" \
        "$file uses the ASCII '->' arrow in a comment - prose arrows are the Unicode →:"
}

# The same arrow rule for Markdown prose, skipping fenced blocks and inline code spans.
check_ascii_arrows_prose() {
    local arrows
    arrows=$(< "$staged_blob" awk -v lines=" $(printf '%s ' $added_lines)" '
        /^[[:space:]]*(```|~~~)/ { fenced = !fenced; next }
        fenced || index(lines, " " NR " ") == 0 { next }
        { prose = $0; gsub(/`[^`]*`/, "", prose); if (prose ~ / -> /) print NR ": " $0 }' || true)
    [ -z "$arrows" ] || fail "$arrows" \
        "$file uses the ASCII '->' arrow - prose arrows are the Unicode →:"
}

# A Unicode arrow glued to its neighbor - `key→id` - reads as one token to searchers and
# renderers alike; the arrow always gets whitespace on both sides.
check_glued_arrows() {
    local glued
    glued=$(printf '%s\n' "$added" | grep -E '[^[:space:]]→|→[^[:space:]]' || true)
    [ -z "$glued" ] || fail "$glued" \
        "$file glues a Unicode arrow to its neighbor - write \`key → identifier\`, never \`key→identifier\`:"
}

# Markdown paragraphs are separated by one blank line, so a run of two carries no meaning and only
# shows as noise in a diff. Fenced blocks keep whatever they hold.
check_blank_line_runs() {
    local runs
    runs=$(awk '
        /^```/ || /^~~~/ { fence = !fence }
        !fence && /^[[:space:]]*$/ { blanks++; if (blanks > 1) print NR ": consecutive blank lines"; next }
        { blanks = 0 }
    ' "$file" || true)
    [ -z "$runs" ] || fail "$runs" \
        "$file separates paragraphs with more than one blank line - Markdown needs exactly one:"
}

# Backward-looking prose in comments - "v2", "v3", "the previous implementation" - rots the moment
# the rewrite ships and reads as changelog noise. Docstrings describe behavior on its own terms,
# forward-looking; history belongs in commit messages and design documents.
check_backward_references() {
    local backrefs
    # Case-sensitive on purpose: lowercase `v2` is a version reference, while uppercase `V2` names
    # real hardware, like the Arm Neoverse cores. Three digits name a SIMD tier like `v128`, never a version.
    backrefs=$(printf '%s\n' "$added" | grep -E '(//|/\*|^\+[[:space:]]*\*)' |
        grep -E '\bv[0-9]{1,2}\b|[Tt]he (previous|old|legacy) (design|implementation|version|draft|approach|convention|code)|\bused to (be|do|work)\b' || true)
    [ -z "$backrefs" ] || fail "$backrefs" \
        "$file cites a past version in a comment - describe the behavior on its own terms;" \
        "            history belongs in commit messages and design docs:"
}

# Rejects an added banner ruler outside Markdown: a comment that opens or closes on a run of `---`, `===`, `####`,
# `////`, `***` or horizontal box-drawing strokes, a line of such runs around an optional label, or a string literal
# that prints one. Box corners and verticals stay free for diagrams, a `|` line for Markdown tables, and YAML keeps
# its `---` document marker. Reads `+` lines, or a whole diff, from stdin.
check_banners() { # check_banners <path> < added-lines
    case "$1" in
    *.c | *.h | *.cc | *.cpp | *.cxx | *.hpp | *.hxx | *.cu | *.cuh | *.hip | *.metal | *.pml | *.py | *.pyi | *.pyx | \
        *.rs | *.go | *.zig | *.mojo | *.js | *.mjs | *.cjs | *.ts | *.mts | *.tsx | *.swift | *.java | *.kt | *.cs | \
        *.toml | *.yml | *.yaml | *.cmake | *CMakeLists.txt | *.sh) ;;
    *) return 0 ;;
    esac
    local rulers
    rulers=$(awk -v path="$1" -v quote="'" '
        BEGIN {
            stroke = "(─|━|┄|┅|┈|┉|╌|╍|═)"
            run = "(---+|===+|####+|////+|\\*\\*\\*+|" stroke stroke stroke "+)"
            marker = "^(#|//|/\\*|\\*|--|;)[!/*<]?[ \t]*"
            printed = "(----+|====+|####+|" stroke stroke stroke "+)"
            literal = "[\"" quote "][ \t]*" printed "|" printed "[ \t]*[\"" quote "]"
        }
        /^\+/ {
            text = substr($0, 2); sub(/^[ \t]+/, "", text); sub(/[ \t\r]+$/, "", text)
            if (text == "---" && path ~ /\.ya?ml$/) next
            if (text ~ ("^" run "([ \t].*[ \t]" run ")?$") || text ~ (marker run "[ \t]*(\\*/)?([ \t]|$)") ||
                (text ~ marker && text ~ ("[ \t]" run "[ \t]*(\\*/)?$")) || (text ~ literal && text !~ /\|/))
                print
        }')
    [ -z "$rulers" ] && return 0
    echo "pre-commit: $1 adds a banner ruler; name a section with #pragma region or # region, or a plain sentence:"
    printf '%s\n' "$rulers" | head -5
    return 1
}

# A `#pragma region` label must be letters, digits & spaces only. clang-format tokenises the label
# as code, so a dash, ampersand, colon, or any other symbol makes it reflow the marker and the
# regions drift out of place on the next format run. Keep the label a plain phrase:
# `#pragma region Name`.
check_region_labels() {
    local symbolic
    symbolic=$(printf '%s\n' "$added" |
        grep -E '^\+[[:space:]]*#pragma[[:space:]]+(end)?region[[:space:]]' |
        grep -E '#pragma[[:space:]]+(end)?region[[:space:]]+.*[^A-Za-z0-9 ]' || true)
    [ -z "$symbolic" ] || fail "$symbolic" \
        "$file has a symbol in a #pragma region label - write \`#pragma region Traversal Scratch\`;" \
        "            clang-format reflows a label carrying anything but letters, digits & spaces:"
}

# A design justified by another project's design ages into a lie the moment that project moves,
# and it tells a reader nothing about the code in front of them. State what it does and why.
check_sibling_justification() {
    local borrowed
    borrowed=$(printf '%s\n' "$added" | grep -inE \
        '(the (way|split|shape|idiom|dialect|convention|form|style|precedent))[^.]{0,40}(numkong|stringzilla|forkunion|smashtable|usearch|sibling)|(numkong|stringzilla|forkunion|smashtable|usearch|sibling)[^.]{0,40}(idiom|dialect|house style|does it|spells it|takes|would)|(matching|mirror(s|ing)?|mimic(s|king)?|copie[sd]|borrow(s|ed)?|same as) (how )?(numkong|stringzilla|forkunion|smashtable|usearch|the sibling)' || true)
    [ -z "$borrowed" ] || fail "$borrowed" \
        "$file justifies a design by a sibling project - say what this code does and why," \
        "            not which repository it was copied from:"
}

# Markdown structure inside a docblock - `* ## Class Specs`, `* - Copyable: Yes.`, `* 1. First` - prints literally in
# Doxygen and hides what the tags would say. Headings become prose, and specs become @note, @throws or @param lines.
# The one list left is the `- @c status` bullets under `@par Statuses:`.
check_markdown_docblocks() {
    local structure
    structure=$(printf '%s\n' "$added" | grep -E '^\+[[:space:]]*\*[[:space:]]+(#{1,4}[[:space:]]|-[[:space:]]+[^@[:space:]]|[0-9]+\.[[:space:]])' || true)
    [ -z "$structure" ] || fail "$structure" \
        "$file puts a Markdown heading or list inside a docblock - use Doxygen tags such as @note," \
        "            @throws and @param, or plain sentences:"
}

# Rejects a pipe-table row in a comment of a code file, because a header table is plain columns aligned with
# spaces, which reads the same in an editor, a terminal and a diff; pipe tables belong only in Markdown files.
check_tables_aligned_not_piped() {
    local piped
    piped=$(printf '%s\n' "$added" | grep -E '^\+[[:space:]]*(\*|//[/!]?|#)[[:space:]]+\|.*\|[[:space:]]*$' || true)
    [ -z "$piped" ] || fail "$piped" \
        "$file draws a pipe table in a comment; pipe tables belong only in Markdown, so align plain" \
        "            columns with spaces, indented 4 past the prose, as in \`*      Instruction   Notes\`:"
}

# endregion Comments and Prose

# region Doxygen Blocks

# Every @param declares its direction - [in]/[out]/[in,out] - so a reader knows whether the callee
# reads, writes, or mutates the argument. A bare @param and the [inout] spelling are both
# rejected; the one spelling for a mutated argument is @param[in,out].
check_param_directions() {
    local bare
    bare=$(printf '%s\n' "$added" | grep -E '@param' | grep -vE '@param\[(in|out|in,out)\]' || true)
    [ -z "$bare" ] || fail "$bare" \
        "$file has a @param without an [in], [out] or [in,out] direction, or writes [inout]," \
        "            which Clang rejects:"
}

# Doxygen renders @b / @c, not Markdown: `__bold__` / `**bold**` in a `/** */` or `//` comment print
# literally. Use @b for a one/two-token emphasis and plain prose for anything longer. C `__keyword__`
# spellings are exempt; Markdown files never route here.
check_markdown_doxygen() {
    local emphasis
    emphasis=$(printf '%s\n' "$added" | grep -E '^\+[[:space:]]*(\*|//)' |
        grep -oE '\*\*[^*]+\*\*|__[^_]+__' |
        grep -vE '^__(restrict|inline|volatile|asm|attribute|builtin[A-Za-z0-9_]*|STDC)__$' |
        grep -vE '^__[a-z][a-z0-9_]*__$' || true)
    [ -z "$emphasis" ] || fail "$emphasis" \
        "$file uses Markdown emphasis in a Doxygen comment (it prints literally) - use @b" \
        "            for a 1-2 token emphasis, plain prose otherwise:"
}

# A Doxygen command glued to the preceding character - `(@c foo)`, `-@ref bar` - breaks syntax
# highlighting in most viewers, which only recognize the command after whitespace. Reword the
# sentence so the command stands free; parentheses around a command are the usual offender.
check_doxygen_glued() {
    local glued
    glued=$(printf '%s\n' "$added" | grep -E '^\+[[:space:]]*(\*|//)' |
        grep -E '[^[:space:]]@(brief|section|subsection|param|tparam|returns?|ref|see|note|file|date|author|c|p|b)\b' || true)
    [ -z "$glued" ] || fail "$glued" \
        "$file glues a Doxygen command to the previous character - write \`as @c foo does\`," \
        "            never \`(@c foo)\`; a highlighter only sees a command that follows whitespace:"
}

# Clang hovers print the backticks of a docblock literally, so a docblock names code with @c, @p or <tt>
# by token class; backticks stay in `//` comments, and code samples inside @code are exempt.
check_docblock_code_spans_not_backticked() {
    local spans
    spans=$(printf '%s\n' "$added" | awk '
        /@endcode/ { code = 0; next }
        /@code/ { code = 1; next }
        code { next }
        /^\+[[:space:]]*(\/\*\*|\*|\/\/\/)/ && /`/ { print }')
    [ -z "$spans" ] || fail "$spans" \
        "$file has a backtick span in a docblock - write @c name, @p parameter or <tt>punctuated token</tt>;" \
        "            backticks stay in // comments:"
}

# Doxygen text aligned into columns by hand - `@brief  Text`, `@param[in] a     Text` - drifts out of
# line with the first edit to a neighbor, so one space follows a command and one the name it documents.
check_doxygen_columns_unaligned() {
    local aligned
    aligned=$(printf '%s\n' "$added" | grep -E '^\+[[:space:]]*(/\*\*|\*([[:space:]]|$)|//)' | grep -E \
        '@(file|author|date|brief|param|tparam|returns?|retval|note|warning|details|pre|post|sa|see|ref|c|p|b)(\[[a-z,]+\])?  +[^[:space:]]|@(t?param(\[[a-z,]+\])?|retval) +[A-Za-z_][A-Za-z0-9_.]*  +[^[:space:]]' ||
        true)
    [ -z "$aligned" ] || fail "$aligned" \
        "$file aligns Doxygen text into columns by hand - write \`@param[in] count Rows to read\`," \
        "            one space after the command and one after the name it documents:"
}

# An `@section` line reads as a heading only when air surrounds it: the comment lines directly
# above and below must be empty (`*` alone). Spacing is context, not a line, so this reads the
# whole staged file and reports only the headings the commit itself added. A `@par` section reads the
# same way: an empty comment line above it, and below it unless it ends the docblock.
check_section_spacing() {
    grep -q '@section\|@par' "$staged_blob" || return 0
    local cramped
    cramped=$(awk '
        NR == FNR { added[$1 + 0]; next }
        { lines[FNR] = $0; last = FNR }
        END {
            for (i = 1; i <= last; ++i) {
                if (lines[i] ~ /@section/ && (i in added)) {
                    if (lines[i - 1] !~ /^[[:space:]]*\*[[:space:]]*$/) printf "line %d: no empty comment line above the @section\n", i
                    if (lines[i + 1] !~ /^[[:space:]]*\*[[:space:]]*$/) printf "line %d: no empty comment line below the @section\n", i
                }
                if (lines[i] ~ /^[[:space:]]*\*[[:space:]]*@par([^a-z]|$)/ && (i in added)) {
                    if (lines[i - 1] !~ /^[[:space:]]*\*[[:space:]]*$/ && lines[i - 1] !~ /^[[:space:]]*\/\*\*[[:space:]]*$/) printf "line %d: no empty comment line above the @par\n", i
                    for (j = i + 1; j <= last; ++j)
                        if (lines[j] ~ /^[[:space:]]*\*[[:space:]]*$/ || lines[j] ~ /\*\// || lines[j] ~ /^[[:space:]]*\*[[:space:]]*@(brief|param|tparam|return|returns|retval|note|warning|sa|see|throws|pre|post|par|section|code)([^a-z]|$)/) break
                    if (lines[j] !~ /^[[:space:]]*\*[[:space:]]*$/ && lines[j] !~ /\*\//) printf "line %d: no empty comment line below the @par section\n", i
                }
            }
        }' "$staged_lines_path" "$staged_blob")
    [ -z "$cramped" ] || fail "$cramped" \
        "$file crams an @section or @par against its neighbors - keep one empty comment line" \
        "            above and below every @section heading, and around every @par section that does not end the docblock:"
}

# A docblock reads as the start of something only when air sits above it, with no exception: an opening
# brace and an access specifier earn their blank line like anything else. Spacing is context rather than
# a line, so this reads the whole staged file and reports only the docblocks the commit itself added.
check_docblock_spacing() {
    local cramped
    cramped=$(awk '
        NR == FNR { added[$1 + 0]; next }
        { lines[FNR] = $0; last = FNR }
        END {
            for (i = 2; i <= last; ++i)
                if (lines[i] ~ /^[[:space:]]*\/\*\*/ && (i in added) && lines[i - 1] !~ /^[[:space:]]*$/)
                    printf "line %d: no empty line above the docblock\n", i
        }' "$staged_lines_path" "$staged_blob")
    [ -z "$cramped" ] || fail "$cramped" \
        "$file opens a docblock against the line above - every /** takes an empty line above it," \
        "            an opening brace and an access specifier included:"
}

# A `@brief` separates a summary from what follows it, so a block with nothing following carries no
# tag. Block tags are the contract trio, the file header's, and the cross-references; `@c`, `@p`,
# `@b` and `@ref` are inline markup and open nothing. A blank comment line counts too - it starts a
# body paragraph. Whole staged file, since a block is context, and only the blocks this commit added.
check_lone_brief() {
    local lone
    lone=$(awk '
        NR == FNR { added[$1 + 0]; next }
        { lines[FNR] = $0; last = FNR }
        END {
            for (i = 1; i <= last; ++i) {
                if (lines[i] !~ /^[[:space:]]*\/\*\*/) continue
                brief = 0; section = 0; blank = 0; touched = 0
                for (j = i; j <= last; ++j) {
                    if (j in added) touched = 1
                    if (lines[j] ~ /@brief/) brief = 1
                    if (lines[j] ~ /^[[:space:]]*(\/\*\*|\*)[[:space:]]*@(param|tparam|return|retval|par|sa|see|note|file|author|date|section|code)([^a-z]|$)/) section = 1
                    if (lines[j] ~ /^[[:space:]]*\*[[:space:]]*$/) blank = 1
                    if (lines[j] ~ /\*\//) break
                }
                if (brief && touched && !section && !blank)
                    printf "line %d: @brief with nothing to separate it from\n", i
                i = j
            }
        }' "$staged_lines_path" "$staged_blob")
    [ -z "$lone" ] || fail "$lone" \
        "$file tags a docblock that is one unstructured paragraph - drop the @brief," \
        "            it earns its place only above a body paragraph or a tag section:"
}

# The indented summary runs at most three lines; past that the remainder is a body paragraph, which
# is unindented and sits below a blank comment line.
check_brief_length() {
    local sprawling
    sprawling=$(awk '
        NR == FNR { added[$1 + 0]; next }
        { lines[FNR] = $0; last = FNR }
        END {
            for (i = 1; i <= last; ++i) {
                if (lines[i] !~ /@brief/) continue
                span = 1
                for (j = i + 1; j <= last; ++j) {
                    if (lines[j] !~ /^[[:space:]]*\*[[:space:]]{5,}[^[:space:]]/) break
                    if (lines[j] ~ /^[[:space:]]*\*[[:space:]]*@(param|tparam|return|retval|par|sa|see|note|file|author|date|section|code)([^a-z]|$)/) break
                    ++span
                }
                if (span > 3 && (i in added)) printf "line %d: @brief runs %d lines\n", i, span
            }
        }' "$staged_lines_path" "$staged_blob")
    [ -z "$sprawling" ] || fail "$sprawling" \
        "$file lets a @brief summary run past three lines - keep the summary short and move" \
        "            the rest into an unindented body paragraph below a blank comment line:"
}

# Markdown tables align every pipe by display width and stay within 120 columns, so they read unwrapped.
# Width counts a UTF-8 character as one column, the emoji these docs use as two, and the combining dot \314\207 as none.
check_markdown_tables() {
    local tables
    tables=$(< "$staged_blob" LC_ALL=C awk -v lines=" $(printf '%s ' $added_lines)" '
        function width(text,   copy, columns) {
            copy = text
            columns = length(text) - gsub(/[\200-\277]/, "", copy)
            copy = text
            columns += gsub(/⚪|✅|❌|🌳|🐍|🚧|🤢|🥰|🦀|🧐|🧩/, "", copy)
            copy = text
            return columns - gsub(/\314\207/, "", copy)
        }
        function trim(text) {
            sub(/^[[:space:]]+/, "", text)
            sub(/[[:space:]]+$/, "", text)
            return text
        }
        function check(   touched, row, body, count, columns, i, character, cell, code, escaped, cells, separator,
                          widths, column, formatted, left, right, aligned) {
            for (row = 1; row <= rows; ++row) if (index(lines, " " (first + row - 1) " ")) touched = 1
            if (!touched) return
            for (row = 1; row <= rows; ++row) {
                body = trim(table[row])
                sub(/^\|/, "", body)
                if (body ~ /\|$/ && body !~ /\\\|$/) body = substr(body, 1, length(body) - 1)
                count = 1
                cell = ""
                code = escaped = 0
                for (i = 1; i <= length(body); ++i) {
                    character = substr(body, i, 1)
                    if (escaped) escaped = 0
                    else if (character == "\\") escaped = 1
                    else if (character == "`") code = !code
                    else if (character == "|" && !code) {
                        cells[row, count++] = trim(cell)
                        cell = ""
                        continue
                    }
                    cell = cell character
                }
                cells[row, count] = trim(cell)
                if (count > columns) columns = count
            }
            separator = rows > 1
            for (column = 1; column <= columns; ++column) {
                if (cells[2, column] !~ /^:?-+:?$/) separator = 0
                widths[column] = 3
            }
            for (row = 1; row <= rows; ++row)
                for (column = 1; column <= columns; ++column)
                    if (!(separator && row == 2) && width(cells[row, column]) > widths[column])
                        widths[column] = width(cells[row, column])
            aligned = 1
            for (row = 1; row <= rows; ++row) {
                formatted[row] = "|"
                for (column = 1; column <= columns; ++column) {
                    cell = cells[row, column]
                    if (separator && row == 2) {
                        left = cell ~ /^:/
                        right = length(cell) > 1 && cell ~ /:$/
                        cell = (left ? ":" : "")
                        for (i = left + right; i < widths[column]; ++i) cell = cell "-"
                        if (right) cell = cell ":"
                    } else
                        for (i = width(cell); i < widths[column]; ++i) cell = cell " "
                    formatted[row] = formatted[row] " " cell " |"
                }
                if (formatted[row] != table[row]) aligned = 0
            }
            if (!aligned) printf "line %d: table cells are not aligned\n", first
            for (row = 1; row <= rows; ++row)
                if (width(formatted[row]) > 120)
                    printf "line %d: table row is %d columns, over 120\n", first + row - 1, width(formatted[row])
        }
        /^[[:space:]]*```/ { fenced = !fenced }
        !fenced && /^\|/ {
            if (!rows) first = NR
            table[++rows] = $0
            next
        }
        rows { check(); rows = 0 }
        END { if (rows) check() }' || true)
    [ -z "$tables" ] || fail "$tables" \
        "$file has misaligned or overwide tables - pad each cell to its column's widest, emoji counting as two columns," \
        "            fill the separator row with dashes, and shorten rows past 120 columns:"
}

# Colors come from fmt styles, which stay empty when output is piped, never from raw ANSI escape sequences.
check_ansi_escapes() {
    local escapes
    escapes=$(printf '%s\n' "$added" | grep -E '\\033\[|\\x1[bB]\[|\\e\[|\\u001[bB]\[' || true)
    [ -z "$escapes" ] || fail "$escapes" \
        "$file writes a raw ANSI escape - style output with \`fmt::fg\` or \`fmt::styled\`, empty when the stream is piped:"
}

# Docblock text sits two spaces past its asterisk, so tags and prose align one column inside the gutter.
check_docblock_indent() {
    local misindented
    misindented=$(awk '
        NR == FNR { added[$1 + 0]; next }
        {
            if (inside && $0 ~ /\*\//) {
                if ((FNR in added) && $0 ~ /^[[:space:]]*\* [^[:space:]]/) printf "line %d: one space past the asterisk\n", FNR
                inside = 0
                next
            }
            if (inside && (FNR in added)) {
                if ($0 ~ /^[[:space:]]*\*[^[:space:]\/]/) printf "line %d: text glued to the asterisk\n", FNR
                else if ($0 ~ /^[[:space:]]*\* [^[:space:]]/) printf "line %d: one space past the asterisk\n", FNR
            }
            if ($0 ~ /^[[:space:]]*\/\*\*/ && $0 !~ /\*\//) inside = 1
        }' "$staged_lines_path" "$staged_blob")
    [ -z "$misindented" ] || fail "$misindented" \
        "$file indents docblock text one space past the asterisk - use two, as in \` *  @brief\`:"
}

# A line continuing a block tag hangs four columns past the ` *  ` prefix, so a note reads as one paragraph.
check_tag_continuation() {
    local aligned
    aligned=$(awk '
        NR == FNR { added[$1 + 0]; next }
        /^[[:space:]]*\*  @(brief|param|tparam|return|returns|retval|note|warning|sa|see|pre|post|throws|deprecated)(\[[a-z,]+\])? / { open = 1; next }
        /^[[:space:]]*\*  @/ || /^[[:space:]]*\*\/?[[:space:]]*$/ || !/^[[:space:]]*\*/ { open = 0; next }
        open && (FNR in added) && !/^[[:space:]]*\*      [^[:space:]]/ { printf "line %d: %s\n", FNR, $0 }
        ' "$staged_lines_path" "$staged_blob")
    [ -z "$aligned" ] || fail "$aligned" \
        "$file continues a tag at the wrong column - a continuation line hangs four spaces past the prefix, \` *      like this\`:"
}

# Includes form groups in a fixed order with a blank line between them: the C library, the platform's own
# headers, the C++ standard library, external libraries, sibling projects, then this project's own headers.
# Only headers in this repository are quoted, found beside the including file or anywhere in the index, and
# public ones under `c/` and `cpp/` always with the `project_include_prefix`. Includes under an `#if` keep their
# quoting but sit outside the grouping; an include guard is not such an `#if`.
check_include_groups() {
    local misgrouped
    misgrouped=$(awk -v project="$project_include_prefix" -v file="$file" '
        BEGIN {
            split("cassert cctype cerrno cfenv cfloat cinttypes climits clocale cmath csetjmp csignal cstdarg " \
                  "cstddef cstdint cstdio cstdlib cstring ctime cuchar cwchar cwctype", names, " ")
            for (n in names) clibrary[names[n]] = 1
            split("dirent.h dlfcn.h errno.h fcntl.h ftw.h poll.h pthread.h sched.h signal.h stdio.h stdlib.h " \
                  "string.h time.h unistd.h io.h windows.h bcrypt.h malloc.h", names, " ")
            for (n in names) platform[names[n]] = 1
            split("forkunion numkong smashtable stringzilla uform usearch ustore", names, " ")
            for (n in names) sibling[names[n]] = 1
            split("C-library platform C++-standard external sibling own", labels, " ")
        }
        NR == FNR { added[$1 + 0]; next }
        guard != "" && NF {
            if ($1 == "#define" && $2 == guard) { --depth; counted[level] = 0 }
            guard = ""
        }
        /^[[:space:]]*#[[:space:]]*if/ { ++depth; counted[++level] = 1; guard = ($1 == "#ifndef") ? $2 : "" }
        /^[[:space:]]*#[[:space:]]*endif/ { depth -= counted[level--] }
        {
            if ($0 ~ /^[[:space:]]*#[[:space:]]*include[[:space:]]*[<"]/) {
                header = $0
                quoted = ($0 ~ /include[[:space:]]*"/)
                sub(/^[^<"]*[<"]/, "", header); sub(/[>"].*$/, "", header)
                root = header; sub(/[\/.].*$/, "", root)
                touched = (FNR in added)
                if (root == project) rank = 6
                else if (header in clibrary) rank = 1
                else if ((header in platform) || header ~ /^(sys|linux|arpa|netinet|asm)\//) rank = 2
                else if (header !~ /[\/.]/) rank = 3
                else if (root in sibling) rank = 5
                else rank = 4
                if (quoted && rank != 5 && rank != 6) {
                    directory = file; sub(/[^\/]*$/, "", directory); found = ""
                    search = "git ls-files \":(glob)**/" header "\""
                    if (touched && !system("git cat-file -e \":" directory header "\" 2>/dev/null")) found = directory header
                    else if (touched) { search | getline found; close(search) }
                    if (touched && found == "")
                        printf "line %d: \"%s\" is not in this repository - write <%s>\n", FNR, header, header
                    if (found ~ ("^c(pp)?/" project "/")) {
                        sub(/^[^\/]*\//, "", found)
                        printf "line %d: \"%s\" is a public header - write \"%s\"\n", FNR, header, found
                    }
                    rank = 6
                }
                if (touched && quoted && rank != 6)
                    printf "line %d: \"%s\" is a %s header - write <%s>\n", FNR, header, labels[rank], header
                if (touched && !quoted && rank == 6)
                    printf "line %d: <%s> is an own header - write \"%s\"\n", FNR, header, header
                if (depth) next
                if (touched && block && rank != block)
                    printf "line %d: a %s header shares its group with %s ones\n", FNR, labels[rank], labels[block]
                if (touched && !block && rank < previous)
                    printf "line %d: a %s group follows a %s group\n", FNR, labels[rank], labels[previous]
                if (!block) block = rank
            }
            else if ($0 !~ /^[[:space:]]*#/) { if (block) previous = block; block = 0 }
        }' "$staged_lines_path" "$staged_blob")
    [ -z "$misgrouped" ] || fail "$misgrouped" \
        "$file misgroups its includes - C library, platform, C++ standard, external, <sibling/...>," \
        "            then \"$project_include_prefix/...\", each group separated by a blank line:"
}

# A docblock's brackets say whether it is structured. With no block tag it is prose, so the text
# starts on the opener and closes on its last line; with one it earns dedicated `/**` and `*/` lines.
# A file's own header names itself before it describes itself: @file, @author, @date, @brief, in that
# order, contiguous, with any prose below them. The whole staged file, since the header is context.
check_file_header() {
    local header
    header=$(awk '
        NR == FNR { added[$1 + 0]; next }
        { lines[FNR] = $0; last = FNR }
        END {
            for (i = 1; i <= last; ++i) if (lines[i] ~ /^[[:space:]]*\/\*\*/) break
            if (i > last) { print "line 1: no header docblock"; exit }
            wanted = "file author date brief"; split(wanted, order, " ")
            seen = 0; blank = 0; touched = 0
            for (j = i; j <= last; ++j) {
                if (j in added) touched = 1
                if (lines[j] ~ /^[[:space:]]*\*[[:space:]]*$/) blank = 1
                if (match(lines[j], /@(file|author|date|brief)/)) {
                    tag = substr(lines[j], RSTART + 1, RLENGTH - 1)
                    ++seen
                    if (seen <= 4 && tag != order[seen])
                        printf "line %d: @%s where @%s belongs\n", j, tag, order[seen]
                    if (blank) printf "line %d: @%s sits below a blank line, outside the tag block\n", j, tag
                }
                if (lines[j] ~ /\*\//) break
            }
            if (touched && seen < 4) printf "line %d: the header names only %d of @file, @author, @date, @brief\n", i, seen
        }' "$staged_lines_path" "$staged_blob")
    [ -z "$header" ] || fail "$header" \
        "$file misorders its file header - name the file, then the author, the date, and the summary," \
        "            contiguously, with any prose below them:"
}

check_docblock_brackets() {
    local shape
    shape=$(awk '
        NR == FNR { added[$1 + 0]; next }
        { lines[FNR] = $0; last = FNR }
        END {
            for (i = 1; i <= last; ++i) {
                if (lines[i] !~ /^[[:space:]]*\/\*\*/) continue
                tagged = 0; touched = 0; single = (lines[i] ~ /\*\//)
                for (j = i; j <= last; ++j) {
                    if (j in added) touched = 1
                    if (lines[j] ~ /^[[:space:]]*(\/\*\*|\*)[[:space:]]*@(brief|param|tparam|return|retval|par|sa|see|note|file|author|date|section|code)([^a-z]|$)/) tagged = 1
                    if (lines[j] ~ /\*\//) break
                }
                bare_open = (lines[i] ~ /^[[:space:]]*\/\*\*[[:space:]]*$/)
                bare_close = (lines[j] ~ /^[[:space:]]*\*\/[[:space:]]*$/)
                expanded = (bare_open || bare_close)
                if (touched && !single) {
                    if (tagged && !expanded) printf "line %d: tagged docblock without its own /** and */ lines\n", i
                    if (!tagged && expanded) printf "line %d: untagged docblock spending lines on bare /** and */\n", i
                }
                i = j
            }
        }' "$staged_lines_path" "$staged_blob")
    [ -z "$shape" ] || fail "$shape" \
        "$file mismatches a docblock's brackets to its content - prose opens on the /** and closes" \
        "            on its last line, a tagged block takes dedicated /** and */ lines:"
}

# A header's @date is when the file was created, not when it was last touched: git records every edit
# since, and the header keeps the one fact git cannot show without archaeology.
check_header_date() {
    local rewritten
    rewritten=$(git diff --cached --unified=0 -- "$file" | awk '
        /^-[^-].*@date/ { value = $0; sub(/^.*@date[[:space:]]+/, "", value); removed[value] = $0 }
        /^\+[^+].*@date/ { value = $0; sub(/^.*@date[[:space:]]+/, "", value); added[value] = 1 }
        END { for (value in removed) if (!(value in added)) print removed[value] }' || true)
    [ -z "$rewritten" ] || fail "$rewritten" \
        "$file rewrites the @date in its header - that is the creation date, and git holds the edits:"
}

# Member documentation is Doxygen: a bare `//` line directly above a declaration (a member or a type)
# is the banned doc style - those entities get `/** @brief ... */`. The same `Type name = ...;` shape
# inside a function body is a local variable and its `//` note is a legal implementation note, and
# this library is header-only so headers carry both - so the staged file is read whole and the brace
# stack says which scope each declaration sits in, with only the added pairings reported.
check_bare_member_docs() {
    local member_docs
    member_docs=$(awk '
        NR == FNR { added[$1 + 0]; next }
        {
            line = $0
            # Block comments are stripped first, so a brace inside a docblock never moves the stack.
            if (in_comment) { if (match(line, /\*\//)) { line = substr(line, RSTART + 2); in_comment = 0 } else next }
            gsub(/\/\*([^*]|\*[^\/])*\*\//, " ", line)
            if (match(line, /\/\*/)) { line = substr(line, 1, RSTART - 1); in_comment = 1 }
            comment_at = index(line, "//")
            code = comment_at ? substr(line, 1, comment_at - 1) : line
            if (comment_at && substr(line, comment_at + 2, 1) != "/" && code ~ /^[[:space:]]*$/) { pending = $0; pending_line = FNR }
            else if (kind[depth] == "record" && pending &&
                     code ~ /^[[:space:]]*[A-Za-z_][A-Za-z0-9_:<>,* ]* [A-Za-z_][A-Za-z0-9_]* *([={;]|$)/) {
                if ((pending_line in added) || (FNR in added)) printf "line %d:%s\n", pending_line, pending
                pending = ""
            }
            else if (code !~ /^[[:space:]]*$/) pending = ""
            # `statement` holds the declaration text since the last terminator, so a class whose
            # brace sits on a continuation line still opens a record scope.
            statement = statement " " code
            for (position = 1; position <= length(code); ++position) {
                character = substr(code, position, 1)
                if (character == "{") {
                    ++depth
                    kind[depth] = (kind[depth - 1] == "code") ? "code" \
                        : (statement ~ /(^|[^A-Za-z0-9_])(class|struct|union|enum)([^A-Za-z0-9_]|$)/) ? "record" \
                        : (statement ~ /(^|[^A-Za-z0-9_])namespace([^A-Za-z0-9_]|$)/) ? "namespace" : "code"
                    statement = ""
                } else if (character == "}") { if (depth > 0) delete kind[depth--]; statement = "" }
                else if (character == ";") statement = ""
            }
        }' "$staged_lines_path" "$staged_blob" || true)
    [ -z "$member_docs" ] || fail "$member_docs" \
        "$file documents a declaration with a bare \`//\` comment - docs are" \
        "            /** @brief ... */ blocks; \`//\` is for implementation notes inside bodies:"
}

# A member documented after it - `parsed_k, ///< Every argument matched.` - is the one declaration whose doc does not
# hover above it, and its column drifts with every rename; the doc goes on the line above as a `/** ... */` one-liner.
check_trailing_member_docs() {
    local trailing
    trailing=$(printf '%s\n' "$added" | grep -E '(///<|//!<|/\*\*<|/\*!<)' || true)
    [ -z "$trailing" ] || fail "$trailing" \
        "$file documents a member after it with ///< - put a /** ... */ one-liner on the line above:"
}

# endregion Doxygen Blocks

# region Naming and Vocabulary

# The full `unum::ustore::` spelling belongs to two places: the `using namespace` and `namespace` lines,
# and the specializations of foreign templates - `std::hash<unum::ustore::...>`, `fmt::formatter<...>` - which
# have to name the type from outside. Everywhere else the name is already in scope - through the directive a
# translation unit opened with, or the enclosing namespace itself.
check_qualified_namespace() {
    local spelled
    spelled=$(printf '%s\n' "$added" |
        grep -vE '^\+[[:space:]]*(\*|//|/\*)' |
        grep -vE 'using namespace unum::ustore|namespace unum::ustore' |
        grep -vE 'struct (std|fmt)::[A-Za-z_]+<([^<>]*, *)?unum::ustore::' |
        grep -E 'unum::ustore::' || true)
    [ -z "$spelled" ] || fail "$spelled" \
        "$file spells unum::ustore:: in full - the name is already in scope through a \`using\` directive" \
        "            or the enclosing namespace; only a foreign template specialization earns it:"
}

# The namespaces a C++ source opens at file scope, as `line:name`, reading past comments, literals, and
# preprocessor lines; an anonymous namespace prints as `<anonymous>`.
top_level_namespaces() { # top_level_namespaces < source
    awk '
        continued { continued = ($0 ~ /\\$/); next }
        {
            code = ""
            for (i = 1; i <= length($0); ++i) {
                c = substr($0, i, 1)
                pair = substr($0, i, 2)
                if (state == "block") { if (pair == "*/") { state = ""; ++i } continue }
                if (state != "") {
                    if (c == "\\") ++i
                    else if (c == state) state = ""
                    continue
                }
                if (pair == "//") break
                if (pair == "/*") { state = "block"; ++i; continue }
                if (c == "\"" || c == "'\''") { state = c; continue }
                code = code c
            }
            if (state != "block") state = ""
            if (code ~ /^[[:space:]]*#/) { continued = ($0 ~ /\\$/); next }
            if (depth == 0 && match(code, /(^|[^A-Za-z0-9_])namespace([[:space:]]+[A-Za-z_][A-Za-z0-9_:]*)?[[:space:]]*\{/)) {
                name = substr(code, RSTART, RLENGTH)
                sub(/^.*namespace[[:space:]]*/, "", name)
                sub(/[[:space:]]*\{$/, "", name)
                print NR ":" (name == "" ? "<anonymous>" : name)
            }
            depth += gsub(/\{/, "{", code) - gsub(/\}/, "}", code)
        }'
}

# Namespaces mirror directories. A nameless `namespace {` hides helpers in a scope no path names, and a
# namespace no directory backs, like `ram::stores` for `src/ram/engine.cpp`, invents structure the tree does
# not have. Allowed names: `unum`, `ustore`, the sibling libraries' roots, a directory on the file's path
# (`src_oracles` answers for `oracles`), and a directory beside the file. The `c/` and `cpp/` include roots
# name none, so `cpp/ustore/` opens `unum::ustore`. The whole staged file, since the namespace is context.
check_namespace_directories() {
    local directory=${file%/*} allowed name misplaced=""
    [ "$directory" = "$file" ] && directory=.
    allowed=" unum ustore ashvardanian numkong stringzilla forkunion smashtable "
    for name in $(printf '%s\n' "$directory" | sed -E 's#^c(pp)?/##' | tr '/' '\n'); do
        allowed="$allowed$name ${name##*_} "
    done
    for name in $(git ls-tree -d --name-only HEAD "$directory/" 2> /dev/null); do allowed="$allowed${name##*/} "; done
    while IFS=: read -r line opened; do
        if [ -z "$opened" ]; then
            misplaced="${misplaced}line $line: a nameless namespace
"
            continue
        fi
        for name in $(printf '%s\n' "$opened" | tr ':' '\n'); do
            [ -z "$name" ] && continue
            case "$allowed" in
            *" $name "*) ;;
            *) misplaced="${misplaced}line $line: namespace $name
" ;;
            esac
        done
    done < <(awk '/^[[:space:]]*namespace([[:space:]]+[A-Za-z_][A-Za-z0-9_:]*)?[[:space:]]*\{/ {
            opened = $0; sub(/^[[:space:]]*namespace[[:space:]]*/, "", opened); sub(/[[:space:]]*\{.*/, "", opened)
            print NR ":" opened }' "$staged_blob")
    [ -z "$misplaced" ] || fail "${misplaced%$'\n'}" \
        "$file opens a namespace no directory backs - use the directory's namespace, and \`static\` for file-local helpers:"
}

# A namespace opens once per file: closing it only to reopen it splits its body around whatever sits between,
# usually an include that belongs in the preamble or a handle completed between two halves. The one gap allowed
# holds a `fmt::` or `std::` specialization, which has to follow the type it formats or hashes and precede the
# first use, all outside the namespace. The whole staged file, since the namespace is context.
check_namespace_reopened() {
    local namespaces reopened
    namespaces=$(top_level_namespaces < "$staged_blob")
    [ -n "$namespaces" ] || return 0
    reopened=$(printf '%s\n' "$namespaces" |
        awk -F: -v path="$file" '
            NR == FNR {
                name = substr($0, index($0, ":") + 1)
                if (name in opened) reopening[$1 + 0] = name
                opened[name]
                next
            }
            { lines[FNR] = $0 }
            END {
                for (line in reopening) {
                    foreign = 0
                    for (gap = line - 1; gap > 0 && lines[gap] !~ ("^\\} // namespace " reopening[line] "$"); --gap)
                        if (lines[gap] ~ /^struct (fmt|std)::[a-z_]+</) foreign = 1
                    if (!foreign) printf "%s:%d: reopens namespace %s\n", path, line, reopening[line]
                }
            }' - "$staged_blob")
    [ -z "$reopened" ] || fail "$reopened" \
        "$file reopens namespace ${reopened##*namespace } - keep includes in the preamble and open each namespace once:"
}

# Template type parameters carry a trailing underscore - `typename variant_type_`, never
# `typename multi_t` - a special case of the underscore marking internal symbols: a
# parameter is internal to its template, exists only to be materialized, and must never
# collide with the public `_t` aliases and `_k` constants it produces. Dependent-name uses
# (`typename foo_::bar`) never match, since the `::` breaks the identifier early.
check_template_parameter_underscores() {
    local bare
    bare=$(printf '%s\n' "$added" |
        grep -vE '^\+[[:space:]]*(\*|//|/\*)' |
        grep -E 'typename ?(\.\.\.)? +([A-Za-z][A-Za-z_0-9]*[A-Za-z0-9]|[A-Za-z]) *(,|>|=|$)' || true)
    [ -z "$bare" ] || fail "$bare" \
        "$file declares a template type parameter without the trailing underscore - write" \
        "            \`template <typename scalar_type_>\`, so it cannot collide with the _t alias it materializes:"
}

# Function-like ALL_CAPS macros - every macro here is object-like: include guards, config
# flags, platform shims. Preprocessor codegen hides the very lines a reader greps for, so
# write the expansion out; a truly unavoidable file-local generator is snake_case_ + #undef.
check_function_like_macros() {
    local generators
    generators=$(printf '%s\n' "$added" | grep -E '^\+[[:space:]]*#[[:space:]]*define[[:space:]]+[A-Z][A-Z0-9_]*\(' || true)
    [ -z "$generators" ] || fail "$generators" \
        "$file defines a function-like ALL_CAPS macro - write the expansion out, or name a" \
        "            file-local generator snake_case_ and #undef it after use:"
}

# A bare `bool` parameter is unreadable at the call site - `setup(n, true, false)` names
# nothing. Public headers spell the choice with a two-value enum; predicate helpers in
# tests & benches, where the bool IS the domain, stay out of scope.
check_boolean_parameters() {
    local flags
    flags=$(printf '%s\n' "$added" | grep -E '[(,] ?bool [a-z_]+' || true)
    [ -z "$flags" ] || fail "$flags" \
        "$file takes a bare bool parameter - name both states, as in" \
        "            \`enum class ordering_t : bool { ascending_k, descending_k };\`:"
}

# A function that opens with `auto` and names its result after the signature buries the one thing a
# reader scans a header for. Spell the type first, qualifying it where an out-of-class definition
# needs it. Lambdas, deduction guides and `requires` clauses keep their arrows - they have no other
# spelling - so the rejected shapes are a declaration opening with `auto`, and a wrapped signature
# whose continuation line opens with the arrow. Member access binds its arrow tight, which is what
# separates `index->search` from a return type.
check_trailing_returns() {
    local trailing
    trailing=$(printf '%s\n' "$added" |
        grep -nE '^\+[[:space:]]*((static|inline|constexpr|friend)[[:space:]]+)*auto[[:space:]]+[A-Za-z_].*->[[:space:]]|^\+[[:space:]]*->[[:space:]]' |
        grep -vE '\[[^]]*\][[:space:]]*\(|requires|concept' || true)
    [ -z "$trailing" ] || fail "$trailing" \
        "$file declares a trailing return type - write \`status_t insert(key_t key)\`," \
        "            not \`auto insert(key_t key) -> status_t\`:"
}

# Redundant result annotations in C++ sources - `status_t` and `expected` carry a type-level
# `[[nodiscard]]`, so repeating it on a signature returning them is noise the type already
# enforces; the attribute on a function should mean something the type cannot say.
check_redundant_nodiscard() {
    local redundant
    redundant=$(printf '%s\n' "$added" |
        grep -E '\[\[nodiscard\]\][[:space:]]+((static|inline|constexpr|virtual)[[:space:]]+)*(status_t|expected<)' |
        grep -vE 'struct|enum' || true)
    [ -z "$redundant" ] || fail "$redundant" \
        "$file repeats [[nodiscard]] on a status_t/expected signature - both types are" \
        "            marked [[nodiscard]] themselves, so drop the annotation:"
}

# A two-way structured binding is an `expected` taken apart, so its halves read `[thing, status]`:
# the status half is `status` or `<verb>_status`, never a participle, and the payload half never
# carries the suffix. A `std::pair` binds under the same rule; `[first, second]` says nothing either.
# The standard conversions answer an end and an `std::errc`, not a status, so `[end, error]` stays.
check_expected_bindings() {
    local participle suffixed
    participle=$(printf '%s\n' "$added" | grep -vE '^\+[[:space:]]*(//|/\*|\*( |/|$))' |
        grep -E 'auto( const)?&? \[[a-z_]+, [a-z_]+\] =' | grep -vE '\b(from_chars|to_chars|format_to_n)\(' |
        grep -vE 'auto( const)?&? \[[a-z_]+, (status|[a-z]+(_[a-z]+)*_status)\] =' || true)
    suffixed=$(printf '%s\n' "$added" | grep -vE '^\+[[:space:]]*(//|/\*|\*( |/|$))' |
        grep -E 'auto( const)?&? \[[a-z_]+_status, ' || true)
    [ -z "$participle$suffixed" ] || fail "$participle$suffixed" \
        "$file binds an expected as [payload, participle] - the status half is \`status\` or \`<verb>_status\`:"
}

# A class template takes a bare name - `class blobs_ref`, never `class blobs_ref_gt` - and nothing UStore declares ends
# in `_at`: template parameters end in a single underscore, and `_t` marks only a materialized type. A declaration
# follows a type, so a call into a sibling that spells its members so, like SmashTable's `reader_at`, passes.
check_suffixed_template_names() {
    local suffixed
    suffixed=$(printf '%s\n' "$added" | grep -vE '^\+[[:space:]]*(\*|//|/\*)' |
        sed -e 's/R"\([A-Za-z_]*\)(.*)\1"/""/g' -e 's/"[^"]*"/""/g' |
        awk '{
            probe = $0
            gsub(/(^|[^A-Za-z0-9_])(return|co_return|throw|case|else|new|delete)[[:space:]]+/, " (", probe)
            if (probe ~ /(^|[^A-Za-z0-9_])(class|struct|union|using)[[:space:]]+[A-Za-z_][A-Za-z0-9_]*_(gt|at)([^A-Za-z0-9_]|$)/ ||
                probe ~ /[A-Za-z0-9_>*&][[:space:]]+[A-Za-z_][A-Za-z0-9_]*_at([^A-Za-z0-9_]|$)/)
                print
        }' || true)
    [ -z "$suffixed" ] || fail "$suffixed" \
        "$file names a symbol with a _gt or _at suffix - write \`template <typename store_> class blobs_ref\`:"
}

# Private and protected data members end in an underscore, so a reader tells state from locals at a glance. The
# staged file is read whole, since access is context: a class starts private, a struct public, and every access
# specifier changes the section; only the added declarations are reported.
check_private_member_underscores() {
    local members
    members=$(awk '
        NR == FNR { added[$1 + 0]; next }
        {
            line = $0
            if (in_comment) { if (match(line, /\*\//)) { line = substr(line, RSTART + 2); in_comment = 0 } else next }
            gsub(/\/\*([^*]|\*[^\/])*\*\//, " ", line)
            if (match(line, /\/\*/)) { line = substr(line, 1, RSTART - 1); in_comment = 1 }
            sub(/\/\/.*/, "", line)
            if (kind[depth] ~ /^record/ && line ~ /^[[:space:]]*(public|protected|private)[[:space:]]*:/) {
                match(line, /(public|protected|private)/); access[depth] = substr(line, RSTART, RLENGTH)
            }
            else if (kind[depth] ~ /^record/ && access[depth] != "public" && (FNR in added) &&
                     line ~ /^[[:space:]]*[A-Za-z_][A-Za-z0-9_:<>,*& ]*[[:space:]*&]+[A-Za-z_][A-Za-z0-9_]*[[:space:]]*(\[[^]]*\])?[[:space:]]*(=[^;]*|\{[^}]*\})?;[[:space:]]*$/ &&
                     line !~ /^[[:space:]]*(using|typedef|friend|return|static[[:space:]]+constexpr|enum|class|struct)[[:space:]]/ &&
                     line !~ /\(/) {
                name = line; sub(/[[:space:]]*(\[[^]]*\])?[[:space:]]*(=[^;]*|\{[^}]*\})?;[[:space:]]*$/, "", name); sub(/.*[[:space:]*&]/, "", name)
                if (name !~ /_$/ && name !~ /_k$/) printf "line %d: %s\n", FNR, $0
            }
            statement = statement " " line
            for (position = 1; position <= length(line); ++position) {
                character = substr(line, position, 1)
                if (character == "{") {
                    ++depth
                    if (kind[depth - 1] == "code") kind[depth] = "code"
                    else if (statement ~ /(^|[^A-Za-z0-9_])class([^A-Za-z0-9_]|$)/) { kind[depth] = "record"; access[depth] = "private" }
                    else if (statement ~ /(^|[^A-Za-z0-9_])(struct|union)([^A-Za-z0-9_]|$)/) { kind[depth] = "record"; access[depth] = "public" }
                    else if (statement ~ /(^|[^A-Za-z0-9_])(namespace|extern)([^A-Za-z0-9_]|$)/) kind[depth] = "namespace"
                    else kind[depth] = "code"
                    statement = ""
                } else if (character == "}") { if (depth > 0) { delete kind[depth]; delete access[depth]; --depth }; statement = "" }
                else if (character == ";") statement = ""
            }
        }' "$staged_lines_path" "$staged_blob" || true)
    [ -z "$members" ] || fail "$members" \
        "$file declares a private or protected data member without a trailing underscore - write \`size_\`:"
}

# A class template never takes the `_t` suffix: `_t` marks a concrete type or the alias a template materializes, so
# `template <...> class channel_drain_t` reads as a type the reader could name without arguments. Name the template
# bare - `channel_drain<disk_type_>` - and keep `_t` for the aliases it produces.
check_template_type_suffixes() {
    local suffixed
    suffixed=$(printf '%s\n' "$added" | awk '
        /^\+[[:space:]]*template[[:space:]]*</ {
            if ($0 ~ /(struct|class)[[:space:]]+[A-Za-z0-9_]+_t([^A-Za-z0-9_]|$)/) print
            pending = 1
            next
        }
        pending && /^\+[[:space:]]*requires/ { next }
        pending && /^\+[[:space:]]*(struct|class)[[:space:]]+[A-Za-z0-9_]+_t([^A-Za-z0-9_]|$)/ { print }
        { pending = 0 }' || true)
    [ -z "$suffixed" ] || fail "$suffixed" \
        "$file names a class template with the _t suffix - name the template bare, as in" \
        "            \`template <typename disk_type_> class channel_drain\`, and keep _t for its aliases:"
}

# Hand-rolled rounding - `(value + divisor - 1) / divisor` or `value & ~(alignment - 1)` - re-derives what the shared
# vocabulary names once: `divide_round_up`, `round_up_to_multiple` and `round_down_to_multiple` in `ustore/types.hpp`.
check_hand_ceils() {
    local ceils
    ceils=$(printf '%s\n' "$added" | grep -vE 'divide_round_up|round_up_to_multiple|round_down_to_multiple' |
        grep -E '\([^()]+\+[^()]+-[[:space:]]*1[[:space:]]*\)[[:space:]]*/|&[[:space:]]*~[[:space:]]*\([^()]+-[[:space:]]*1[[:space:]]*\)' || true)
    [ -z "$ceils" ] || fail "$ceils" \
        "$file hand-rolls rounding - write divide_round_up, round_up_to_multiple or round_down_to_multiple" \
        "            from ustore/types.hpp:"
}

# endregion Naming and Vocabulary

# region C++ Surface and Containers

# C stdio printing in C++ sources - tests & headers print through fmt::. The C bindings under c/
# keep their stdio; the dispatch below only routes C++ translation units here.
check_printf() {
    local prints
    prints=$(printf '%s\n' "$added" | grep -E '\b(std::)?(f|s)?printf[[:space:]]*\(|\bputs[[:space:]]*\(' || true)
    [ -z "$prints" ] || fail "$prints" \
        "$file prints through the C stdio family - write fmt::println(\"{} rows\", count):"
}

# A `fmt::print` whose literal does not end in a newline is half a line, and the other half
# arrives in a second call - `fmt::styled` and `fmt::join` fold both halves into one `println`.
# A literal opening with a carriage return is a redraw, never a fragment.
check_partial_prints() {
    local partial
    partial=$(printf '%s\n' "$added" | grep -E 'fmt::print\(' | grep -vE '\\n"' | grep -vE 'fmt::print\("\\r' || true)
    [ -z "$partial" ] || fail "$partial" \
        "$file prints half a line - fold it into one fmt::println, with fmt::styled or fmt::join:"
}

# C++ iostreams - `std::cout`, `std::ifstream`, `std::ostringstream`, and the rest of the
# `std::*stream` family - are banned wholesale: locale-dependent, allocation-happy, and verbose.
# Printing goes through fmt::, file reading through the C stdio family or mmap views.
check_stl_streams() {
    local streams
    streams=$(printf '%s\n' "$added" |
        grep -E 'std::[a-z_]*stream|std::(cout|cerr|cin|clog|endl)\b|#[[:space:]]*include[[:space:]]*<(iostream|sstream|fstream|ostream|istream|iomanip)>' || true)
    [ -z "$streams" ] || fail "$streams" \
        "$file uses C++ iostreams - print through fmt::, read files through C stdio or mmap:"
}

# `std::deque` - a chunked indirection-heavy container with unpredictable locality. Address
# stability comes from reserved vectors of `unique_ptr`, arenas, or ForkUnion's containers.
check_deque() {
    local deques
    deques=$(printf '%s\n' "$added" |
        grep -E 'std::deque\b|#[[:space:]]*include[[:space:]]*<deque>' || true)
    [ -z "$deques" ] || fail "$deques" \
        "$file uses std::deque - reach for reserved unique_ptr vectors, arenas, or ForkUnion containers:"
}

# `std::filesystem` throws, allocates paths behind the caller's back, and is missing or partial on several
# targets the bindings ship to. The library and its bindings reach files through the C library and mmap views;
# only the test, benchmark and tool harnesses may include `<filesystem>`.
check_filesystem_in_library() {
    local hits
    hits=$(printf '%s\n' "$added" | grep -vE '^\+[[:space:]]*(//|/\*|\*( |/|$))' |
        grep -E '\bstd::filesystem\b|#[[:space:]]*include[[:space:]]*<filesystem>' || true)
    [ -z "$hits" ] || fail "$hits" \
        "$file uses std::filesystem in library code - it is allowed only in test/, bench/ and tools/ harnesses:"
}

# Reinterpreting copies in C++ sources - a `memcpy` between two objects whose byte count is one
# object's `sizeof` is a type pun, and `std::bit_cast` states it outright. Byte moves keep their
# memcpy: a runtime-sized bulk copy, or one object serialized into or out of a byte run.
check_memcpy() {
    local puns
    # A pun takes the address of both objects and a lone `sizeof(...)` byte count; a copy whose
    # source or destination is a byte pointer is a serialization and passes.
    puns=$(printf '%s\n' "$added" | grep -E '\bmemcpy[[:space:]]*\([[:space:]]*&[^,]*,[[:space:]]*&' |
        grep -E ',[[:space:]]*sizeof[[:space:]]*\([^)]*\)[[:space:]]*\)' || true)
    [ -z "$puns" ] || fail "$puns" \
        "$file reinterprets one object through memcpy - write \`auto bits = std::bit_cast<u64_t>(value);\`:"
}

# A range rebuilt from its own parts - `{x.data(), x.size()}`, `{file->view().data(), file->view().size()}`
# or `std::span<T const>(x.data(), x.size())` - means a conversion or an accessor is missing: `std::vector`
# converts to `std::span`, `std::string_view` to StringZilla's views, and containers can grow
# `begin()`/`end()`. Pass the range itself.
check_range_reconstruction() {
    local rebuilt
    # The range may be reached through calls and arrows, and rebuilt in braces or in a view's parentheses
    rebuilt=$(printf '%s\n' "$added" |
        grep -E '(\{|(span|string_view|_view_t|_span_t)(<.*>)?( const)?( [a-z_]+)? *\() *([A-Za-z_][A-Za-z0-9_.()>-]*)(\.|->)data\(\), *\6(\.|->)size\(\) *[})]' || true)
    [ -z "$rebuilt" ] || fail "$rebuilt" \
        "$file rebuilds a range from its own .data()/.size() - pass the range itself," \
        "            or add the missing accessor or conversion:"
}

# `.data()` as an emptiness probe reads as pointer plumbing; every NumKong tensor, view,
# and span - like the STL containers - spells it `empty()`.
check_data_null_probe() {
    local probes
    probes=$(printf '%s\n' "$added" |
        grep -E '![A-Za-z_][A-Za-z0-9_.]*\.data\(\)|\.data\(\) *== *nullptr' || true)
    [ -z "$probes" ] || fail "$probes" \
        "$file probes emptiness through .data() - write \`if (values.empty())\`:"
}

# Subscripting a call's result chains two accessors where the container offers one:
# `matrix.row(i)[j]`, `pool.begin()[i]`, and `.data()[i]` all hide the same raw-pointer hop.
# Use the multi-index `operator()` - `matrix(i, j)` - or the container's own `operator[]`;
# a bare `.data()` pointer is reserved for one-time lifts handed to syscalls and SIMD kernels.
check_call_chained_subscript() {
    local chained
    # An identifier must sit against the opening parenthesis, so a dereference `(*owner)[i]` and
    # an array-reference parameter `(&ids)[width]` stay out of it - neither is a call.
    chained=$(printf '%s\n' "$added" | grep -E '[A-Za-z0-9_>]\([^()]*\)\[' || true)
    [ -z "$chained" ] || fail "$chained" \
        "$file subscripts a call result - write matrix(row, column) or results[index]," \
        "            never results.data()[index]:"
}

# The `&*iterator` antipattern - laundering an iterator through a reference into a pointer. Take the
# container's `data()`, or address the element itself.
check_iterator_laundering() {
    local laundered
    laundered=$(printf '%s\n' "$added" | grep -E '&\*[A-Za-z_]' || true)
    [ -z "$laundered" ] || fail "$laundered" \
        "$file launders an iterator through &* - write \`values.data() + offset\`, or address the element:"
}

# The in-house engines never throw, so their calls fill the `noexcept` table of `src/engine.hpp` as they are; only the
# oracles, whose libraries throw, wrap theirs in `guarded`. A `throw` or a `noexcept(false)` here would break that.
check_in_house_never_throws() {
    local throwing
    throwing=$(printf '%s\n' "$added" | grep -vE '^\+[[:space:]]*(//|/\*|\*( |/|$))' |
        grep -E '\bthrow\b|noexcept[[:space:]]*\([[:space:]]*false[[:space:]]*\)' || true)
    [ -z "$throwing" ] || fail "$throwing" \
        "$file throws in an in-house engine - answer a status_t, since every call of the engine table is noexcept:"
}

# Every in-house function promises not to throw, as the engine table's calls do. Signatures are joined across lines, and
# control statements, lambdas, types and the `ustore_*` C exports, which a C header declares, are skipped.
check_in_house_noexcept() {
    local missing
    missing=$(< "$staged_blob" awk -v lines=" $(printf '%s ' $added_lines)" '
        function reset() { head = ""; first = 0; touched = 0 }
        {
            line = $0
            sub(/[[:space:]]*\/\/.*$/, "", line)
            if (line ~ /^[[:space:]]*(\/\*|\*|#|$)/ || line ~ /^[[:space:]]*((public|private|protected|default)[[:space:]]*:|case )/) {
                reset()
                next
            }
            if (!first) first = NR
            if (index(lines, " " NR " ")) touched = 1
            opened = line
            if (opened ~ /\) ?(const )?\{.*\}[[:space:]]*;?[[:space:]]*$/) sub(/\{.*$/, "{", opened)
            head = head " " opened
            if (opened !~ /\{[[:space:]]*$/) {
                if (line ~ /[;}][[:space:]]*$/) reset()
                next
            }
            text = head
            gsub(/[[:space:]]+/, " ", text)
            sub(/^ /, "", text)
            defines = text ~ /\)( const)?( ->[^{]*)? \{$/ || text ~ /\) : [^{]*\{$/
            control = text ~ /^(if|else|for|while|switch|catch|do|return|\})/ || text ~ /(^| )(if|for|while|switch) \(/
            skipped = text ~ /\[[^]]*\] ?\(|= ?\[|(^| )(struct|class|union|enum|namespace|extern|concept|requires) |(^| )ustore_[a-z_]+\(/
            if (touched && defines && !control && !skipped && text !~ /noexcept/) print first ": " text
            reset()
        }' || true)
    [ -z "$missing" ] || fail "$missing" \
        "$file defines a function without noexcept in an in-house engine, which never throws:"
}

# The CPython bindings parse arguments and build results by hand: `PyArg_Parse*` and `Py_BuildValue` interpret a
# format string at runtime, so a wrong specifier is a crash rather than a compile error.
check_cpython_format_shortcuts() {
    local shortcuts
    shortcuts=$(printf '%s\n' "$added" | grep -vE '^\+[[:space:]]*(//|/\*|\*( |/|$))' |
        grep -E '\b(Py_BuildValue|PyArg_Parse[A-Za-z]*|PyArg_UnpackTuple)[[:space:]]*\(' || true)
    [ -z "$shortcuts" ] || fail "$shortcuts" \
        "$file calls a format-string shortcut of the C API - walk the arguments by hand and build results with" \
        "            PyDict_New and PyLong_FromUnsignedLongLong:"
}

# endregion C++ Surface and Containers

# region Concurrency and Atomics

# Host threads managing GPUs in CUDA sources - fleets of NVLink-resident devices are
# orchestrated with per-device non-blocking streams and events from one host thread: kernel
# launches are already asynchronous, cross-device ordering is `cudaStreamWaitEvent`, and
# completion is an event-sync loop, so `std::thread` adds nothing but scheduling noise.
check_host_threads() {
    local threads
    threads=$(printf '%s\n' "$added" |
        grep -E '\bstd::(thread|jthread|async)\b|#include[[:space:]]*<thread>|\bpthread_' || true)
    [ -z "$threads" ] || fail "$threads" \
        "$file spawns host threads in a GPU backend - orchestrate devices with per-device" \
        "            non-blocking cudaStream_t + cudaEvent_t from one host thread:"
}

# GCC atomic builtins fork the memory-model dialect. In-place words go through
# `std::atomic_ref` with explicit `std::memory_order` - the same currency the ForkUnion
# waiters monitor, so loads, stores & waits compose.
check_gcc_atomics() {
    local builtins
    builtins=$(printf '%s\n' "$added" | grep -E '__atomic_[a-z_]+|__builtin_[a-z_]+|__ATOMIC_[A-Z_]+' || true)
    [ -z "$builtins" ] || fail "$builtins" \
        "$file uses a GCC atomic builtin - write std::atomic_ref{word}.load(std::memory_order_acquire)," \
        "            naming the memory order at every access:"
}

# A TSan unlock bracket hides the word's own atomics, so the raw release that pairs with a
# wait-free probe's `annotate_acquire` has to come right before `annotate_unlock*_started`,
# never inside the bracket - or the probe's edge vanishes under TSan.
check_annotate_release_before_unlock() {
    printf '%s\n' "$added" | grep -q 'annotate_' || return 0
    local probed misplaced
    probed=$(grep -o 'annotate_acquire(&[a-z_]*' "$file" | sed 's/.*(//' | sort -u | tr '\n' ' ')
    [ -n "$probed" ] || return 0
    misplaced=$(awk -v probed=" $probed" '
        /annotate_unlock(_shared)?_started\(&[a-z_]+\)/ {
            match($0, /&[a-z_]+/); word = substr($0, RSTART, RLENGTH); inside = 1
            if (index(probed, " " word " ") && previous !~ ("annotate_release\\(" word "\\)")) print FILENAME ":" NR ": " $0
        }
        /annotate_unlock(_shared)?_finished\(/ { inside = 0 }
        inside && /annotate_release\(/ { print FILENAME ":" NR ": " $0 }
        NF && $0 !~ /^[[:space:]]*\/\// { previous = $0 }
    ' "$file")
    [ -z "$misplaced" ] || fail "$misplaced" \
        "$file misplaces the release of a probed word - write annotate_release(&word) immediately" \
        "            before annotate_unlock_started(&word), never inside the bracket:"
}

# Types share state through members they own and free functions they call; a base class hides who owns what and
# couples every derived type to its layout. Trait specializations and formatters keep their bases.
check_inheritance() {
    local hits
    hits=$(printf '%s\n' "$added" | grep -vE '^\+[[:space:]]*(//|/\*|\*( |/|$))' | sed 's/::/~~/g' |
        grep -E '^\+[[:space:]]*(template[[:space:]]*<.*>[[:space:]]*)?(struct|class)[[:space:]]+[A-Za-z_][A-Za-z0-9_<>~, ]*[[:space:]]*(final[[:space:]]*)?:[[:space:]]*(public|protected|private|[A-Za-z_])' |
        sed 's/~~/::/g' |
        grep -vE 'formatter<|std::(true|false)_type|std::integral_constant|std::bool_constant|enum[[:space:]]+(struct|class)' || true)
    [ -z "$hits" ] || fail "$hits" "$file derives a type - hold the shared part as a member, or share a free function:"
}

# A lock added to make something work is a redesign postponed: partition the ownership, publish through an atomic
# protocol on a ForkUnion reference, or wait through the class's waiter.
check_new_mutexes() {
    local hits
    hits=$(printf '%s\n' "$added" | grep -vE '^\+[[:space:]]*(//|/\*|\*( |/|$))' |
        grep -E '\bstd::(recursive_|timed_|recursive_timed_|shared_|shared_timed_)?mutex\b|\bfu::spin_mutex_t\b|#[[:space:]]*include[[:space:]]*<(shared_)?mutex>' || true)
    [ -z "$hits" ] || fail "$hits" \
        "$file adds a mutex - ask first, or protect the state by ownership or an atomic protocol:"
}

# endregion Concurrency and Atomics

# region Tests and Verification

# A test's oracle is the `expect` family from test/harness.hpp, never `assert`, which compiles out wherever
# NDEBUG is defined and, where it is not, aborts the whole run instead of counting one failure.
check_test_oracle_never_compiled_out() {
    local asserts
    asserts=$(printf '%s\n' "$added" | grep -vE '^\+[[:space:]]*(\*|//|/\*)' |
        grep -E '(^|[^A-Za-z0-9_])assert[[:space:]]*\(' || true)
    [ -z "$asserts" ] || fail "$asserts" \
        "$file asserts in a test - write \`failures += expect_eq(count, 3);\` from test/harness.hpp," \
        "            which counts the failure and never compiles out:"
}

# A test translation unit undefines NDEBUG before its first include, so the asserts inside the code under
# test stay live in the Release builds too. Order is context, so this reads the whole staged file.
check_test_undefines_ndebug() {
    local opening
    opening=$(< "$staged_blob" awk -v wanted="#undef NDEBUG // ! A test's oracle must stay live in every build" '
        in_comment { if ($0 ~ /\*\//) in_comment = 0; next }
        /^[[:space:]]*\/\*/ { if ($0 !~ /\*\//) in_comment = 1; next }
        /^[[:space:]]*(\/\/|$)/ { next }
        { if ($0 != wanted) printf "line %d: %s\n", NR, $0; exit }')
    [ -z "$opening" ] || fail "$opening" \
        "$file does not open with \`#undef NDEBUG // ! A test's oracle must stay live in every build\` -" \
        "            put it on the line below the file docblock, before the first #include:"
}

# A verification model, client or note cites a symbol and its file, never `<file>.<ext>:<line>`, since a
# line number drifts with every edit above it.
check_verification_cites_symbols() {
    local pinned
    pinned=$(printf '%s\n' "$added" | grep -E '[A-Za-z0-9_]\.[A-Za-z]+:[0-9]' || true)
    [ -z "$pinned" ] || fail "$pinned" \
        "$file pins a citation to a line number, which drifts with every edit above it - cite the symbol" \
        "            and its file instead, as \`poll\` in \`linux_uring_files_disk.hpp\`:"
}

# endregion Tests and Verification

# region Build CI and Packaging

# CI workflows - every job and every step carries a `name:`. An unnamed step renders as its raw
# command in the Actions UI, and job names are what branch protection's required checks reference,
# so an anonymous one can't be pinned. A name reads as a plain phrase, never `Name (qualifier)`, and a
# matrix job's name spells every list-valued axis, since GitHub appends `(values)` to one naming none.
# Names are structure, not lines, so unlike the checks above this validates the whole staged file.
check_workflow_names() {
    local misnamed
    misnamed=$(
        < "$staged_blob" awk '
            # A name is plain when no parenthesis is left once its ${{ }} expressions are dropped.
            function check_plain(line,    name) {
                name = line; sub(/^[^:]*:[[:space:]]*/, "", name)
                line = name; gsub(/\$\{\{([^}]|\}[^}])*\}\}/, "", line)
                if (line ~ /[()]/) printf "line %d: `%s` is parenthesized\n", NR, name
            }
            # A matrix job names every list-valued axis, and at least one matrix value when it has none.
            function settle(    axis, count, i) {
                if (job == "" || !job_named || !matrix) return
                count = split(axes, axis, " ")
                for (i = 1; i <= count; ++i)
                    if (job_name !~ ("matrix\\." axis[i] "([^A-Za-z0-9_-]|$)"))
                        printf "line %d: job `%s` leaves the matrix axis `%s` out of its name\n", job_line, job, axis[i]
                if (!count && job_name !~ /matrix\./) printf "line %d: job `%s` names no matrix value\n", job_line, job
            }
            /^name:/ { check_plain($0) }
            # Jobs: two-space keys under the top-level `jobs:` section, named by a four-space `name:`.
            /^jobs:[[:space:]]*$/ { in_jobs = 1; next }
            in_jobs && /^[^ #]/ { in_jobs = 0 }
            in_jobs && /^  [A-Za-z_][A-Za-z0-9_-]*:[[:space:]]*$/ {
                if (job != "" && !job_named) printf "line %d: job `%s` has no name\n", job_line, job
                settle()
                job = substr($1, 1, length($1) - 1); job_line = NR; job_named = 0
                job_name = ""; in_strategy = 0; matrix = 0; axes = ""
            }
            in_jobs && /^    name:/ { job_named = 1; job_name = $0; check_plain($0) }
            # Matrix axes: keys two deeper than `strategy.matrix:` holding a `[a, b]` or `- a` list, never
            # the keys that appear only inside its `include` and `exclude` entries.
            matrix_at && !/^[[:space:]]*(#|$)/ {
                indent = match($0, /[^ ]/) - 1
                if (indent <= matrix_at) matrix_at = 0
                else if (indent == matrix_at + 2 && match($0, /^ *[A-Za-z_][A-Za-z0-9_-]*:/)) {
                    key = substr($0, indent + 1, RLENGTH - indent - 1); value = substr($0, RLENGTH + 1); listed = ""
                    if (key == "include" || key == "exclude") next
                    if (value ~ /^[[:space:]]*\[/) axes = axes " " key
                    else if (value ~ /^[[:space:]]*(#.*)?$/) listed = key
                } else if (listed != "" && $0 ~ /^[[:space:]]*- /) { axes = axes " " listed; listed = "" }
            }
            in_jobs && /^    [^ #]/ { in_strategy = ($0 ~ /^    strategy:/) }
            in_strategy && /^      matrix:/ { matrix = 1; matrix_at = 6; listed = "" }
            # Steps: list items two deeper than their `steps:`, named inline or by a key two deeper.
            /^[[:space:]]*steps:[[:space:]]*$/ { steps_at = index($0, "steps:") - 1; item_at = steps_at + 2; pending = 0; next }
            steps_at {
                indent = match($0, /[^ ]/) - 1
                if ($0 ~ /^[[:space:]]*(#|$)/) next
                if (indent <= steps_at) { if (pending) printf "line %d: unnamed step\n", pending; steps_at = 0; next }
                if (indent == item_at && substr($0, item_at + 1, 2) == "- ") {
                    if (pending) printf "line %d: unnamed step\n", pending
                    pending = ($0 ~ /^[[:space:]]*- name:/) ? 0 : NR
                    if (!pending) check_plain($0)
                } else if (indent == item_at + 2 && $0 ~ /^[[:space:]]*name:/) { pending = 0; check_plain($0) }
            }
            END {
                if (job != "" && !job_named) printf "line %d: job `%s` has no name\n", job_line, job
                settle()
                if (pending) printf "line %d: unnamed step\n", pending
            }
        '
    )
    [ -z "$misnamed" ] || fail "$misnamed" \
        "$file misnames a CI workflow, job or step - each carries a \`name:\` the Actions UI and branch protection" \
        "            reference, a plain phrase like \`Test \${{ matrix.os }} on QEMU\` that spells every list-valued matrix axis:"
}

# Rejects CMake spellings the projects agreed on: parsed arguments through `PARSE_ARGV <n> arg`, functions under the
# project prefix, lowercase locals, loop variables and internals with a trailing underscore, uppercase non-cache names
# only for CMake's own, a sibling's options, the published values or third-party inputs, and caches written once.
check_cmake_conventions() { # check_cmake_conventions <path> <staged-text> <added-line-numbers>
    local findings
    findings=$(awk -v path="$1" -v prefix="$project_include_prefix" -v siblings="$sibling_projects" \
        -v published=" $cmake_published_variables $cmake_third_party_variables " '
        function hit(rule, message) {
            if (!(rule in messages)) { order[++rules] = rule; messages[rule] = message }
            if (++hits[rule] <= 5) found[rule] = found[rule] first ": " opening "\n"
        }
        function judge(    name, arguments, tokens, count, variable, cached, forced, index_) {
            match(bare, /[A-Za-z_][A-Za-z0-9_]*/); name = tolower(substr(bare, RSTART, RLENGTH))
            arguments = substr(bare, index(bare, "(") + 1)
            sub(/\)[[:space:]]*$/, "", arguments); sub(/^[[:space:]]+/, "", arguments)
            count = split(arguments, tokens, /[[:space:]]+/)
            if (index(code, "${${")) hit("indirect", "reads a name through `${${`; return through an output parameter")
            if (name == "macro") hit("macro", "defines a `macro()`; write a `function()`")
            if (name == "cmake_parse_arguments" && arguments !~ /^PARSE_ARGV[[:space:]]+[0-9]+[[:space:]]+arg( |$)/)
                hit("parse", "parses arguments other than through `PARSE_ARGV <n> arg`")
            if (name == "function" && (index(tokens[1], prefix "_") != 1 || tokens[1] ~ /_$/))
                hit("function", "names a function without the `" prefix "_` prefix or with a trailing `_`")
            if (name == "foreach" && tokens[1] !~ /_$/) hit("foreach", "names a loop variable without a trailing `_`")
            if (name != "set" || tokens[1] ~ /^(\$|ENV\{)/) return
            variable = tokens[1]
            for (index_ = 2; index_ <= count; ++index_) {
                cached = cached || tokens[index_] == "CACHE"
                forced = forced || tokens[index_] == "FORCE"
            }
            if (cached && forced) hit("force", "forces a cache entry, which is written once")
            if (cached) return
            if (variable ~ /^[a-z_](.*[^_])?$/) hit("lowercase", "sets a lowercase local without a trailing `_`")
            if (variable ~ /^[A-Z]/ && variable !~ "^(CMAKE|CPACK|" toupper(siblings) ")_" &&
                !index(published, " " variable " "))
                hit("uppercase", "sets an uppercase name outside CMake, the siblings, and the published and third-party lists")
        }
        NR == FNR { added[$1 + 0]; next }
        {
            line_code = ""; line_bare = ""
            for (position = 1; position <= length($0); ++position) {
                character = substr($0, position, 1)
                if (character == "\\") {
                    line_code = line_code substr($0, position, 2)
                    if (!quoted) line_bare = line_bare substr($0, position, 2)
                    ++position; continue
                }
                if (character == "\"") quoted = !quoted
                else if (character == "#" && !quoted) break
                else if (character == "(" && !quoted) ++depth
                else if (character == ")" && !quoted) --depth
                line_code = line_code character
                if (!quoted || character == "\"") line_bare = line_bare character
            }
            if (!open) {
                if (line_bare !~ /^[[:space:]]*[A-Za-z_][A-Za-z0-9_]*[[:space:]]*\(/) { depth = 0; next }
                open = 1; first = FNR; opening = $0; code = ""; bare = ""; touched = 0
            }
            code = code " " line_code; bare = bare " " line_bare; touched = touched || (FNR in added)
            if (depth <= 0) { if (touched) judge(); open = 0; depth = 0 }
        }
        END {
            for (index_ = 1; index_ <= rules; ++index_)
                printf "pre-commit: %s %s:\n%s", path, messages[order[index_]], found[order[index_]]
        }' \
        "$3" "$2")
    [ -z "$findings" ] && return 0
    printf '%s\n' "$findings"
    return 1
}

# `sys.version` is a display string whose shape is not contractual; every question about the
# running interpreter has a structured answer.
check_python_version_probe() {
    local probes
    probes=$(printf '%s\n' "$added" | grep -nE 'sys\.version[^_]' || true)
    [ -z "$probes" ] || fail "$probes" \
        "$file parses \`sys.version\`, a human-readable string - use \`sys.version_info\` for" \
        "            comparisons or \`platform.python_version()\` for display:"
}

