# The staged paths matching any of the given globs, NUL-delimited for the readers below.
staged_matching() { # staged_matching <glob>...
    local path pattern
    for path in "${staged_paths[@]}"; do
        for pattern in "$@"; do
            case "$path" in
            $pattern)
                printf '%s\0' "$path"
                break
                ;;
            esac
        done
    done
}

# Whether at least one staged path matches one of the given globs.
staged_any() { # staged_any <glob>...
    local path pattern
    for path in "${staged_paths[@]}"; do
        for pattern in "$@"; do
            case "$path" in
            $pattern) return 0 ;;
            esac
        done
    done
    return 1
}

# Rejects Rust imports out of the standard library, external crates, own crate order, or without a blank line
# between those groups and after the last one, which rustfmt leaves alone. It reads the whole source from stdin.
check_rust_use_groups() { # check_rust_use_groups <own-crate> <path> < source
    local findings
    findings=$(awk -v own="$1" -v path="$2" -v quote="'" '
        BEGIN { literal = "r#*\"|\"|" quote "(\\\\.|[^" quote "\\\\])" quote "|//|/\\*" }
        function blanks(width) { return sprintf("%" width "s", "") }
        function count(text, bracket) { return gsub(bracket, "", text) }
        function group(root) {
            if (root == "std" || root == "core" || root == "alloc") return 0
            return root == own || root == "crate" || root == "self" || root == "super" ? 2 : 1
        }
        function blank(from, to,   line) {
            for (line = from; line < to; ++line) if (source[line] ~ /[^[:space:]]/) return 0
            return 1
        }
        {
            source[NR] = $0
            text = $0; masked = ""; plain = 0
            while (text != "") {
                if (depth) {
                    if (!match(text, /\/\*|\*\//)) break
                    depth += substr(text, RSTART, 2) == "/*" ? 1 : -1
                    taken = RSTART + 1
                } else if (closer != "" && !raw) {
                    if (!match(text, /^([^"\\]|\\.)*"/)) break
                    closer = ""; taken = RLENGTH
                } else if (closer != "") {
                    if (!(taken = index(text, closer))) break
                    taken += length(closer) - 1; closer = ""
                } else if (match(text, literal)) {
                    masked = masked substr(text, 1, RSTART - 1)
                    token = substr(text, RSTART, RLENGTH); text = substr(text, RSTART); taken = RLENGTH
                    if (token == "//") break
                    if (token == "/*") depth = 1
                    else if (token ~ /"$/) { raw = token ~ /^r/; closer = "\"" substr(token, 2, RLENGTH - 2) }
                } else { plain = 1; break }
                masked = masked blanks(taken); text = substr(text, taken + 1)
            }
            code[NR] = masked (plain ? text : blanks(length(text)))
        }
        END {
            for (line = 1; line <= NR; ++line) {
                if (!match(code[line], /^ *(pub(\([^)]*\))? +)?use +(::)?[A-Za-z0-9_]+/)) continue
                head = substr(code[line], 1, RLENGTH); rest = substr(code[line], RLENGTH + 1)
                root = head; sub(/^.*[ :]/, "", root)
                for (end = line; !index(rest, ";") && end < NR; rest = code[++end]) {}
                start = line
                while (start > 1 && code[start - 1] ~ /\][[:space:]]*$/) {
                    candidate = start; nesting = 0
                    while (candidate > 1) {
                        --candidate
                        nesting += count(code[candidate], "]") - count(code[candidate], "\\[")
                        if (nesting == 0) break
                    }
                    if (code[candidate] !~ /^[[:space:]]*#\[/) break
                    start = candidate
                }
                match(head, /^ */)
                ++uses; starts[uses] = start; ends[uses] = end; indents[uses] = RLENGTH; roots[uses] = root
            }
            for (use = 1; use <= uses; ++use) {
                category = group(roots[use]); after = source[ends[use] + 1]; gsub(/^[[:space:]]+|[[:space:]]+$/, "", after)
                if (use < uses && indents[use + 1] == indents[use] && blank(ends[use] + 1, starts[use + 1])) {
                    if (group(roots[use + 1]) < category)
                        printf "%s:%d: order imports as standard library, external crates, own crate\n", path, starts[use]
                    if (group(roots[use + 1]) != category && ends[use] + 1 == starts[use + 1])
                        printf "%s:%d: separate import groups with a blank line\n", path, ends[use]
                } else if (ends[use] < NR && after != "" && after != "}")
                    printf "%s:%d: add a blank line after the last import\n", path, ends[use]
            }
        }')
    [ -z "$findings" ] && return 0
    echo "pre-commit: $2 breaks the Rust import groups - standard library, external crates, then the own crate," \
        "a blank line apart:"
    printf '%s\n' "$findings" | head -5
    return 1
}

# Judges one staged path through tiers, each a superset test rather than a hand-kept file list: a path falls
# through every tier it belongs to, so a new directory is covered the day it appears and no check runs twice.
judge_path() {
    local file=$staged_path staged_blob=$results_directory/index/$staged_path
    local staged_lines_path=$results_directory/$ordinal.lines
    added=
    [ ! -f "$results_directory/$ordinal.added" ] || added=$(< "$results_directory/$ordinal.added")
    [ -s "$staged_lines_path" ] || echo > "$staged_lines_path"
    added_lines=$(< "$staged_lines_path")
    case "$file" in
    # Every C and C++ source, wherever it lives: prose, Doxygen and the shared vocabulary.
    *.c | *.h | *.hpp | *.cpp | *.cc | *.cxx | *.cu | *.cuh)
        check_ascii_arrows
        check_glued_arrows
        check_markdown_docblocks
        check_backward_references
        check_region_labels
        check_param_directions
        check_markdown_doxygen
        check_doxygen_glued
        check_docblock_code_spans_not_backticked
        check_doxygen_columns_unaligned
        check_section_spacing
        check_docblock_spacing
        check_lone_brief
        check_brief_length
        check_file_header
        check_header_date
        check_docblock_indent
        check_tag_continuation
        check_ansi_escapes
        check_include_groups
        check_docblock_brackets
        check_bare_member_docs
        check_trailing_member_docs
        check_trailing_returns
        check_iterator_laundering
        ;;&
    # Every C++ source: the C SDK under c/ keeps its C idioms.
    *.hpp | *.cpp | *.cc | *.cxx | *.cu | *.cuh)
        check_qualified_namespace
        check_suffixed_template_names
        check_template_type_suffixes
        check_hand_ceils
        check_private_member_underscores
        check_template_parameter_underscores
        check_function_like_macros
        check_redundant_nodiscard
        check_expected_bindings
        check_printf
        check_partial_prints
        check_stl_streams
        check_deque
        check_memcpy
        check_range_reconstruction
        check_data_null_probe
        check_call_chained_subscript
        check_gcc_atomics
        check_annotate_release_before_unlock
        ;;&
    # CUDA translation units and the headers they compile into.
    *.cu | *.cuh)
        check_host_threads
        ;;&
    # The shipped library: the C ABI under c/ustore/, its C++ wrappers under cpp/ustore/ and the ABI sources under src/.
    c/ustore/*.h | cpp/ustore/*.hpp | src/*.cpp | src/*.cuh)
        check_boolean_parameters
        ;;&
    # Test sources, whose oracle stays live in every build.
    test/*.cpp | test/*.hpp | test/*.cu)
        check_test_oracle_never_compiled_out
        ;;&
    test/*.cpp | test/*.cu)
        check_test_undefines_ndebug
        ;;&
    verification/*)
        check_verification_cites_symbols
        ;;&
    # The in-house engines, whose calls fill the noexcept engine table without a guard.
    src/ram/* | src/nvme/*)
        check_in_house_never_throws
        check_in_house_noexcept
        ;;&
    # The CPython bindings, which build every argument and result by hand.
    python/*.c)
        check_cpython_format_shortcuts
        ;;&
    *.md)
        check_ascii_arrows_prose
        check_markdown_tables
        check_blank_line_runs
        check_glued_arrows
        check_sibling_justification
        ;;
    *.py | *.pyi)
        check_sibling_justification
        check_python_version_probe
        ;;
    .github/workflows/*.yml | .github/workflows/*.yaml) check_workflow_names ;;
    CMakeLists.txt | */CMakeLists.txt | *.cmake)
        check_cmake_conventions "$file" "$staged_blob" "$staged_lines_path" || rejection_count=$((rejection_count + 1))
        ;;
    esac
    # Namespaces mirror directories everywhere but NVMe, whose files keep theirs until its engine is ported.
    case "$file" in
    src/nvme/* | test/nvme_* | bench/nvme_* | tools/nvme_*) ;;
    *.c | *.h | *.hpp | *.cpp | *.cc | *.cxx | *.cu | *.cuh)
        check_namespace_directories
        check_namespace_reopened
        ;;
    esac
    case "$file" in
    include/* | src/* | c/* | cpp/* | python/*)
        case "$file" in
        *.c | *.h | *.cpp | *.hpp | *.cu | *.cuh | *.hip | *.cc | *.cxx | *.mm) check_filesystem_in_library ;;
        esac
        ;;
    esac
    case "$file" in
    include/* | src/*)
        case "$file" in
        *.h | *.cpp | *.hpp | *.cu | *.cuh | *.hip | *.cc | *.cxx)
            check_inheritance
            check_new_mutexes
            ;;
        esac
        ;;
    esac
    case "$file" in
    *.c | *.h | *.hpp | *.cpp | *.cc | *.cxx | *.cu | *.cuh | *.hip | *.metal | *.py | *.pyi | *.rs | *.go | *.swift | \
        *.zig | *.mojo | *.js | *.mjs | *.cjs | *.ts | *.mts | *.java | *.kt | *.cs | *.sh | *.cmake | CMakeLists.txt)
        check_tables_aligned_not_piped
        ;;
    esac
    check_banners "$file" <<< "$added" || rejection_count=$((rejection_count + 1))

    # Each gate runs whole-file, the way its formatter does, and only when that tool and its profile are
    # present. Every one takes explicit paths: `ruff format` on a directory also rewrites README examples.
    case "$file" in
    *.c | *.h | *.hpp | *.cpp | *.cc | *.cu | *.cuh)
        if command -v clang-format > /dev/null 2>&1 && [ -f .clang-format ] &&
            ! clang-format --dry-run -Werror "$file" > /dev/null 2>&1; then
            echo "pre-commit: $file is not clang-format clean - run \`clang-format -i $file\` (the pip-installed 22.x)"
            rejection_count=$((rejection_count + 1))
        fi
        ;;
    *.py | *.pyi)
        if command -v ruff > /dev/null 2>&1 && [ -f pyproject.toml ]; then
            if ! ruff format --check "$file" > /dev/null 2>&1; then
                echo "pre-commit: $file is not ruff-format clean - run \`ruff format $file\`"
                rejection_count=$((rejection_count + 1))
            fi
            if ! ruff check --quiet "$file" > /dev/null 2>&1; then
                echo "pre-commit: $file fails ruff's lints - run \`ruff check --fix $file\`"
                rejection_count=$((rejection_count + 1))
            fi
        fi
        ;;
    *.rs) check_rust_use_groups ustore "$file" < "$staged_blob" || rejection_count=$((rejection_count + 1)) ;;
    esac

    # An integer quotient compared against zero says `a < b` the long way round, and it reads as a
    # second divisibility test beside the `%` it usually sits next to. Every source language, added
    # lines only, with line comments stripped so prose about a quotient does not trip it.
    case "$file" in
    *.c | *.h | *.hpp | *.cpp | *.cu | *.cuh | *.rs | *.zig | *.go | *.cs | *.java | *.swift | *.ts | *.js | *.mojo | *.py)
        quotients=$(awk '
            NR == FNR { added[$1 + 0]; next }
            FNR in added {
                line = $0
                sub(/\/\/.*/, "", line)
                sub(/#.*/, "", line)
                if (line ~ /\/[[:space:]]*[A-Za-z_][A-Za-z0-9_.()]*[[:space:]]*[=!]=+[[:space:]]*0([^.0-9]|$)/)
                    printf "%d:%s\n", FNR, $0
            }' "$staged_lines_path" "$staged_blob")
        if [ -n "$quotients" ]; then
            echo "pre-commit: $file compares an integer quotient against zero - write \`numerator < denominator\`:"
            printf '%s\n' "$quotients" | head -3
            rejection_count=$((rejection_count + 1))
        fi
        ;;
    esac

    # Abbreviated identifiers are banned in favor of whole words: lo/hi/bot must be low/high/bottom.
    # Word-boundary match on the staged content, added lines only.
    case "$file" in
    *.c | *.h | *.hpp | *.cpp | *.cc | *.cu | *.cuh)
        abbreviations=$(awk '
            NR == FNR { added[$1 + 0]; next }
            (FNR in added) && $0 !~ /@/ && $0 ~ /(^|[^A-Za-z0-9_])(lo|hi|bot)([^A-Za-z0-9_]|$)/ { printf "%d:%s\n", FNR, $0 }' \
            "$staged_lines_path" "$staged_blob")
        if [ -n "$abbreviations" ]; then
            echo "pre-commit: $file uses an abbreviated identifier - write low, high, bottom, never lo, hi, bot:"
            printf '%s\n' "$abbreviations" | head -3
            rejection_count=$((rejection_count + 1))
        fi
        ;;
    esac
}

# Runs the gates that judge the commit as a whole, or one formatter over a batch of paths.
run_tree_checks() {
    # JSON and YAML must satisfy the checked-in .dprint.json. Skips without dprint, installed from https://dprint.dev/install.
    if command -v dprint > /dev/null 2>&1; then
        dprint_staged=()
        while IFS= read -r -d '' file; do dprint_staged+=("$file"); done \
            < <(staged_matching '*.json' '*.jsonc' '*.yml' '*.yaml')
        if [ ${#dprint_staged[@]} -gt 0 ] && ! dprint check "${dprint_staged[@]}" > /dev/null 2>&1; then
            echo "pre-commit: staged JSON or YAML is not dprint clean - run \`dprint fmt\`"
            rejection_count=$((rejection_count + 1))
        fi
    fi

    if command -v cmake-format > /dev/null 2>&1 && [ -f .cmake-format.py ]; then
        # The index holds what the commit records, while the working tree may carry the next group's edits.
        local staged_copy
        staged_copy=$(mktemp)
        while IFS= read -r -d '' file; do
            git show ":$file" > "$staged_copy"
            if ! cmake-format -c .cmake-format.py --check "$staged_copy" > /dev/null 2>&1; then
                echo "pre-commit: $file is not cmake-format clean - run \`cmake-format -i $file\` with the repo profile"
                rejection_count=$((rejection_count + 1))
            fi
            # A bare `CMakeLists.txt` pattern matches the whole path, so every SDK's own list needs its prefix.
        done < <(staged_matching 'CMakeLists.txt' '*/CMakeLists.txt' '*.cmake')
        rm -f "$staged_copy"
    fi

    # Editor settings and extension lists stay sorted case-insensitively, so every addition has one place to go.
    editor_lists=$(staged_matching '.vscode/settings.json' '.vscode/extensions.json' '.zed/settings.json' | tr '\0' '\n')
    if [ -n "$editor_lists" ]; then
        unsorted=$(for path in $editor_lists; do
            git show ":$path" | LC_ALL=C awk -v path="$path" '
                { text = text $0 "\n" }
                END {
                    while (text != "") {
                        if (match(text, /^"([^"\\]|\\.)*"/)) {
                            string = substr(text, 2, RLENGTH - 2)
                            if (list && depth == 2 && tolower(string) < previous) unsorted = 1
                            if (list && depth == 2) previous = tolower(string)
                        } else if (!match(text, /^\/\/[^\n]*/) && !match(text, /^\/\*([^*]|\*+[^*\/])*\*+\//) &&
                                   !match(text, /^[^"\/{}\[\]:,]+/)) {
                            RLENGTH = 1
                            token = substr(text, 1, 1)
                            if (token == ":" && depth == 1) {
                                key = string
                                if (path ~ /settings\.json$/ && !(key in seen) && tolower(key) < last_key) unsorted = 1
                                if (!(key in seen)) last_key = tolower(key)
                                seen[key]
                            }
                            if (token == "{" || token == "[") ++depth
                            if (token == "[" && depth == 2 &&
                                key ~ /^(cSpell\.words|recommendations|unwantedRecommendations)$/) {
                                list = 1
                                previous = ""
                            }
                            if (token == "}" || token == "]") --depth
                            if (depth < 2) list = 0
                        }
                        text = substr(text, RLENGTH + 1)
                    }
                    if (unsorted) print path
                }'
        done)
        if [ -n "$unsorted" ]; then
            echo "pre-commit: sort top-level settings keys, cSpell.words and extension recommendations case-insensitively in:"
            printf '    %s\n' $unsorted
            rejection_count=$((rejection_count + 1))
        fi
    fi
}

